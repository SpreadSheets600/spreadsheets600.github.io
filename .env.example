# GitHub Configuration for CMS
GITHUB_PAT=your_github_personal_access_token_here
GITHUB_REPO=your-username/your-repo-name
GITHUB_BRANCH=main

# API Keys (Optional - for live integrations)
# WakaTime API (for coding stats)
WAKATIME_API_KEY=your_wakatime_api_key

# Discord User ID (for Lanyard API)
DISCORD_USER_ID=your_discord_user_id

# Steam API (for gaming stats)
STEAM_API_KEY=your_steam_api_key
STEAM_USER_ID=your_steam_user_id

# Spotify API (for music stats)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# AniList Username (for anime stats)
ANILIST_USERNAME=your_anilist_username
