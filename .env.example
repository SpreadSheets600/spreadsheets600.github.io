# GitHub Configuration (optional - for CMS features)
GITHUB_PAT=your_github_personal_access_token_here
GITHUB_REPO=your-username/your-repo-name
GITHUB_BRANCH=main

# Discord User ID (for Lanyard API - Discord/Spotify status)
DISCORD_USER_ID=your_discord_user_id

# Steam API (for gaming stats)
STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_steam_id
STEAM_VANITY=your_steam_vanity_url

# AniList Username (for anime/manga stats)
ANILIST_USERNAME=your_anilist_username

# Spotify API (for playlists)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_USER_ID=your_spotify_user_id
