---
import Background from "../components/Background.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/phosphor.generated.css";
import "../styles/global.css";
import poppins400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import phosphorRegular from "@phosphor-icons/web/regular/Phosphor.woff2?url";
import phosphorLight from "@phosphor-icons/web/light/Phosphor-Light.woff2?url";
import poppins600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Portfolio Of SpreadSheets600" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://spreadsheets600-api-io.spreadsheets600.workers.dev" crossorigin />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>

		<link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={phosphorRegular} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={phosphorLight} as="font" type="font/woff2" crossorigin />
	</head>
	<body class="min-h-screen relative">
		<Background />
		<div class="app-container min-h-screen flex flex-col">
			<Navbar />
			<main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<slot />
			</main>
			<Footer />
		</div>
		<script>
			import { initFx } from "../lib/fx";
			initFx();
		</script>
	</body>
</html>
