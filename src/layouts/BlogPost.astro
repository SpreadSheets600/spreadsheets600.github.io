---
import Layout from "./Layout.astro";

interface Props {
	title: string;
	description: string;
	date: Date;
	tags?: string[];
	heroImage?: string;
	author?: string;
	authorRole?: string;
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, date, tags = [], heroImage, author, authorRole, headings = [] } = Astro.props;
---

<Layout title={title} description={description}>
	<article class="mx-auto max-w-6xl py-10 sm:py-14">
		<a href="/blog/" class="inline-flex items-center gap-2 mb-4 text-xs uppercase tracking-[0.2em] text-white/50 hover:text-white transition">
			<i class="ph ph-arrow-left"></i>
			Back to Blog
		</a>
		<header class="rounded-3xl border border-white/10 bg-black/40 p-6 sm:p-10 backdrop-blur-xl">
			<h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white">{title}</h1>
			{
				heroImage && (
					<div class="mt-6 overflow-hidden rounded-2xl border border-white/10">
						<img src={heroImage} alt="" class="w-full object-cover" loading="lazy" />
					</div>
				)
			}
		</header>

		<div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">
			<div class="rounded-3xl border border-white/10 bg-black/30 p-6 sm:p-10 backdrop-blur-xl">
				<div class="prose prose-invert max-w-none">
					<slot />
				</div>
			</div>

			<aside class="space-y-6 lg:sticky lg:top-24 h-max">
				<div class="rounded-3xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl">
					<p class="text-xs uppercase tracking-[0.2em] text-white/50">Author</p>
					<p class="mt-2 text-lg font-semibold text-white">{author ?? "Unknown"}</p>
					{authorRole && <p class="text-sm text-white/60">{authorRole}</p>}
				</div>

				<div class="rounded-3xl border border-white/10 bg-black/30 p-5 backdrop-blur-xl">
					<p class="text-xs uppercase tracking-[0.2em] text-white/50">
						{date.toLocaleDateString("en-US", { dateStyle: "long" })}
					</p>
				</div>

				{
					tags.length > 0 && (
						<div class="rounded-3xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl">
							<p class="text-xs uppercase tracking-[0.2em] text-white/50">Tags</p>
							<ul class="mt-3 flex flex-wrap gap-2">
								{tags.map((tag) => (
									<li>
										<a href={`/blog/?q=${encodeURIComponent(tag)}`} class="text-xs px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-white/70 hover:border-white/40 hover:text-white transition">
											{tag}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				{
					headings.length > 0 && (
						<div class="rounded-3xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl">
							<p class="text-xs uppercase tracking-[0.2em] text-white/50">Contents</p>
							<ul class="mt-3 space-y-2 text-sm text-white/70">
								{headings.map((heading) => (
									<li class={`toc-item-${heading.depth}`}>
										<a class="hover:text-white transition" href={`#${heading.slug}`}>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</aside>
		</div>
	</article>
</Layout>

<style>
	.toc-item-3 {
		padding-left: 0.75rem;
		opacity: 0.85;
	}

	.prose :global(img),
	.prose :global(picture > img) {
		width: 100%;
		height: auto;
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(0, 0, 0, 0.25);
	}

	.prose :global(figure) {
		margin: 2rem 0;
	}

	.prose :global(figcaption) {
		margin-top: 0.75rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.6);
	}
</style>
