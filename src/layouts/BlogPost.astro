---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  heroImage?: string;
  author?: string;
  authorRole?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, date, tags = [], heroImage, author, authorRole, headings = [] } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="mx-auto max-w-6xl py-10 sm:py-14">
    <header class="rounded-3xl border border-white/10 bg-black/40 p-6 sm:p-10 backdrop-blur-xl">
      <a href="/blog/" class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-white/50 hover:text-white transition">
        <i class="ph ph-arrow-left" />
        Back to Blog
      </a>

      <p class="mt-4 text-xs uppercase tracking-[0.2em] text-white/50">
        {date.toLocaleDateString("en-US", { dateStyle: "long" })}
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-semibold text-white">{title}</h1>
      <p class="mt-4 text-base sm:text-lg text-white/70">{description}</p>

      {tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="text-xs px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-white/70">{tag}</li>
          ))}
        </ul>
      )}

      {heroImage && (
        <div class="mt-6 overflow-hidden rounded-2xl border border-white/10">
          <img src={heroImage} alt="" class="w-full object-cover" loading="lazy" />
        </div>
      )}
    </header>

    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="rounded-3xl border border-white/10 bg-black/30 p-6 sm:p-10 backdrop-blur-xl">
        <div class="prose prose-invert max-w-none">
          <slot />
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 h-max">
        <div class="rounded-3xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl">
          <p class="text-xs uppercase tracking-[0.2em] text-white/50">Author</p>
          <p class="mt-2 text-lg font-semibold text-white">{author ?? "Unknown"}</p>
          {authorRole && <p class="text-sm text-white/60">{authorRole}</p>}
        </div>

        {tags.length > 0 && (
          <div class="rounded-3xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl">
            <p class="text-xs uppercase tracking-[0.2em] text-white/50">Tags</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="text-xs px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-white/70">{tag}</li>
              ))}
            </ul>
          </div>
        )}

        {headings.length > 0 && (
          <div class="rounded-3xl border border-white/10 bg-black/40 p-5 backdrop-blur-xl">
            <p class="text-xs uppercase tracking-[0.2em] text-white/50">Contents</p>
            <ul class="mt-3 space-y-2 text-sm text-white/70">
              {headings.map((heading) => (
                <li class={`toc-item-${heading.depth}`}>
                  <a class="hover:text-white transition" href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</Layout>

<style>
  .toc-item-3 {
    padding-left: 0.75rem;
    opacity: 0.85;
  }
</style>
