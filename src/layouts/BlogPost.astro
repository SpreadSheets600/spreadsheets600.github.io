---
import Layout from "./Layout.astro";

interface Props {
	title: string;
	date: Date;
	tags?: string[];
	heroImage?: string;
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, date, tags = [], heroImage, headings = [] } = Astro.props;
const defaultAuthor = "SpreadSheets600";

const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<Layout title={title}>
	<article class="mx-auto max-w-6xl py-10 sm:py-14">
		<a href="/blog/" class="mb-4 inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-white/50 transition hover:text-white">
			<i class="ph ph-arrow-left"></i>
			Back to Blog
		</a>
		<header class="card-shell-lg p-6 sm:p-10">
			<h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">{title}</h1>
			{
				heroImage && (
					<div class="mt-6 overflow-hidden rounded-2xl border border-white/10">
						<img src={heroImage} alt="" class="w-full object-cover" loading="lazy" />
					</div>
				)
			}
		</header>

		<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_260px]">
			<div class="card-shell-lg p-6 sm:p-10">
				<div class="markdown-content max-w-none">
					<slot />
				</div>
			</div>

			<aside class="h-max space-y-4 lg:sticky lg:top-24">
				<div class="card-shell p-4">
					<p class="text-xs uppercase tracking-[0.2em] text-white/45">Author</p>
					<p class="mt-2 text-sm font-medium text-white">{defaultAuthor}</p>
				</div>

				<div class="card-shell p-4">
					<p class="text-xs uppercase tracking-[0.2em] text-white/45">Published</p>
					<p class="mt-2 text-sm text-white/80">{date.toLocaleDateString("en-US", { dateStyle: "medium" })}</p>
				</div>

				{
					tags.length > 0 && (
						<div class="card-shell p-4">
							<p class="text-xs uppercase tracking-[0.2em] text-white/45">Tags</p>
							<ul class="mt-3 flex flex-wrap gap-1.5">
								{tags.map((tag) => (
									<li>
										<a href={`/blog/?q=${encodeURIComponent(tag)}`} class="rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] text-white/70 transition hover:border-white/40 hover:text-white">
											{tag}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				{
					tocHeadings.length > 0 && (
						<div class="card-shell p-4">
							<p class="text-xs uppercase tracking-[0.2em] text-white/45">Table of Contents</p>
							<ul class="mt-3 space-y-1.5 text-xs text-white/65">
								{tocHeadings.map((heading) => (
									<li class={`toc-item toc-item-${heading.depth}`}>
										<a class="block truncate rounded-md px-2 py-1 transition hover:bg-white/10 hover:text-white" href={`#${heading.slug}`}>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</aside>
		</div>
	</article>
</Layout>

<style>
	.toc-item {
		border-left: 1px solid rgba(255, 255, 255, 0.1);
	}

	.toc-item-3 {
		margin-left: 0.5rem;
		opacity: 0.9;
	}

	.markdown-content :global(img),
	.markdown-content :global(picture > img) {
		width: 100%;
		height: auto;
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(0, 0, 0, 0.25);
	}

	.markdown-content :global(h2),
	.markdown-content :global(h3),
	.markdown-content :global(h4) {
		scroll-margin-top: 6rem;
	}

	.markdown-content :global(h1) {
		margin-top: 0.25rem;
		margin-bottom: 1rem;
		font-size: clamp(1.75rem, 3vw, 2.3rem);
		font-weight: 700;
		line-height: 1.25;
		color: rgba(255, 255, 255, 0.98);
	}

	.markdown-content :global(h2) {
		margin-top: 2.2rem;
		margin-bottom: 0.9rem;
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		font-weight: 650;
		line-height: 1.35;
		color: rgba(255, 255, 255, 0.96);
	}

	.markdown-content :global(h3) {
		margin-top: 1.8rem;
		margin-bottom: 0.75rem;
		font-size: clamp(1.1rem, 2.1vw, 1.35rem);
		font-weight: 620;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.94);
	}

	.markdown-content :global(p),
	.markdown-content :global(li) {
		font-size: 1rem;
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.82);
	}

	.markdown-content :global(p + p) {
		margin-top: 1rem;
	}

	.markdown-content :global(ul),
	.markdown-content :global(ol) {
		margin: 1rem 0;
		padding-left: 1.35rem;
	}

	.markdown-content :global(ul) {
		list-style-type: disc;
	}

	.markdown-content :global(ol) {
		list-style-type: decimal;
	}

	.markdown-content :global(ul ul) {
		list-style-type: circle;
	}

	.markdown-content :global(ol ol) {
		list-style-type: lower-alpha;
	}

	.markdown-content :global(li + li) {
		margin-top: 0.5rem;
	}

	.markdown-content :global(a) {
		color: rgba(125, 211, 252, 0.95);
		text-underline-offset: 0.2rem;
		transition: color 160ms ease;
	}

	.markdown-content :global(a:hover) {
		color: rgba(186, 230, 253, 0.98);
	}

	.markdown-content :global(blockquote) {
		margin: 1.25rem 0;
		border-left: 3px solid rgba(148, 163, 184, 0.7);
		padding: 0.25rem 0 0.25rem 1rem;
		color: rgba(255, 255, 255, 0.78);
		font-style: italic;
	}

	.markdown-content :global(code) {
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 0.4rem;
		background: rgba(15, 23, 42, 0.65);
		padding: 0.16rem 0.42rem;
		font-size: 0.9em;
		color: rgba(226, 232, 240, 0.95);
	}

	.markdown-content :global(pre) {
		margin: 1.3rem 0;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 0.9rem;
		background: rgba(2, 6, 23, 0.92);
		padding: 1rem;
		overflow-x: auto;
	}

	.markdown-content :global(pre code) {
		border: none;
		background: transparent;
		padding: 0;
	}

	.markdown-content :global(table) {
		width: 100%;
		margin: 1.2rem 0;
		border-collapse: collapse;
	}

	.markdown-content :global(th),
	.markdown-content :global(td) {
		border: 1px solid rgba(255, 255, 255, 0.14);
		padding: 0.6rem 0.72rem;
		text-align: left;
	}

	.markdown-content :global(th) {
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.94);
		font-weight: 600;
	}

	.markdown-content :global(hr) {
		margin: 2rem 0;
		border: none;
		height: 1px;
		background: rgba(255, 255, 255, 0.16);
	}

	.markdown-content :global(figure) {
		margin: 2rem 0;
	}

	.markdown-content :global(figcaption) {
		margin-top: 0.75rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.6);
	}
</style>
