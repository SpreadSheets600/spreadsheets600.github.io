---
const year = new Date().getFullYear();
const ownerName = "SpreadSheets600";
const systemTime = new Date().toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" });

const repo = "SpreadSheets600/spreadsheeets600.github.io";
const branch = "jam-stack";

let latestCommitSha = "unknown";
let latestCommitUrl = "";

try {
	const response = await fetch(`https://api.github.com/repos/${repo}/commits?sha=${encodeURIComponent(branch)}&per_page=1`, {
		headers: {
			Accept: "application/vnd.github+json",
			"X-GitHub-Api-Version": "2022-11-28",
		},
	});

	if (response.ok) {
		const data = await response.json();
		const latest = Array.isArray(data) ? data[0] : null;
		latestCommitSha = latest?.sha?.slice(0, 7) ?? "unknown";
		latestCommitUrl = latest?.html_url ?? "";
	}
} catch {
	latestCommitSha = "unknown";
	latestCommitUrl = "";
}
---

<footer class="w-full">
	<div class="mx-auto max-w-7xl px-4 pb-10 pt-6">
		<div class="card-shell flex flex-col gap-4 rounded-2xl px-5 py-4 text-white shadow-[0_14px_40px_rgba(7,7,14,0.55)] sm:flex-row sm:items-center sm:justify-between">
			<div class="flex flex-wrap items-center gap-3 text-xs font-medium text-white/85">
				<span class="flex items-center gap-2">
					<i class="ph-light ph-copyright text-sm"></i>
					<span>{year} {ownerName}</span>
				</span>
			</div>

			<div class="flex flex-wrap items-center gap-4 text-[11px] font-medium text-white/70">
				<span class="flex items-center gap-2">
					<i class="ph-light ph-clock text-sm text-white/80"></i>
					{systemTime}
				</span>
				<span class="hidden h-1 w-1 rounded-full bg-white/40 sm:inline-block"></span>
				<span class="flex items-center gap-2">
					<i class="ph-light ph-git-commit text-sm text-white/80"></i>
					{
						latestCommitUrl ?
							<a class="hover:text-white" href={latestCommitUrl} target="_blank" rel="noreferrer">
								{latestCommitSha}
							</a>
						:	<span>{latestCommitSha}</span>
					}
				</span>
			</div>
		</div>
	</div>
</footer>
