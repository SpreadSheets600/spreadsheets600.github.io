---
const year = new Date().getFullYear();

const ownerName = "SpreadSheets600";

const fallbackRepo = "spreadsheets600/spreadsheets600.github.io";
---

<footer class="w-full">
	<div class="mx-auto max-w-7xl px-4 pb-10 pt-6">
		<div class="card-shell flex items-center justify-between gap-4 rounded-2xl px-5 py-4 text-white shadow-[0_14px_40px_rgba(7,7,14,0.55)]">
			<div class="flex flex-wrap items-center gap-3 text-xs font-medium text-white/85">
				<span class="flex items-center gap-2">
					<i class="ph-light ph-copyright text-sm"></i>
					<span>{year} {ownerName}</span>
				</span>
			</div>

			<div class="flex flex-wrap items-center gap-4 text-[11px] font-medium text-white/70">
				<span class="flex items-center gap-2">
					<i class="ph-light ph-clock text-sm text-white/80"></i>
					<span id="localTime">--:--</span>
				</span>
				<span class="hidden h-1 w-1 rounded-full bg-white/40 sm:inline-block"></span>
				<span class="hidden items-center gap-2 sm:flex">
					<i class="ph-light ph-git-commit text-sm text-white/80"></i>
					<a id="latestCommitLink" class="hover:text-white" href={`https://github.com/${fallbackRepo}/commits`} target="_blank" rel="noreferrer">
						<span id="latestCommitSha">loading...</span>
					</a>
				</span>
			</div>
		</div>
	</div>
</footer>

<script>
	const fallbackRepo = "spreadsheets600/spreadsheets600.github.io";
	const localTimeElement = document.getElementById("localTime");
	const latestCommitShaElement = document.getElementById("latestCommitSha");
	const latestCommitLinkElement = document.getElementById("latestCommitLink");
	const formatLocalTime = () => new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
	const updateLocalTime = () => {
		if (!localTimeElement) return;
		localTimeElement.textContent = formatLocalTime();
	};

	const updateLatestCommit = async () => {
		if (!latestCommitShaElement || !latestCommitLinkElement) return;
		try {
			const response = await fetch(`https://api.github.com/repos/${fallbackRepo}/commits?per_page=1`, {
				headers: {
					Accept: "application/vnd.github+json",
					"X-GitHub-Api-Version": "2022-11-28",
				},
			});
			if (!response.ok) {
				latestCommitShaElement.textContent = "unknown";
				return;
			}

			const data = await response.json();
			const latest = Array.isArray(data) ? data[0] : null;
			const sha = latest?.sha ? String(latest.sha).slice(0, 7) : "unknown";
			const url = latest?.html_url || `https://github.com/${fallbackRepo}/commits`;
			latestCommitShaElement.textContent = sha;
			latestCommitLinkElement.setAttribute("href", url);
		} catch {
			latestCommitShaElement.textContent = "unknown";
		}
	};

	updateLocalTime();
	void updateLatestCommit();
	setInterval(updateLocalTime, 30000);
</script>
