---
// Local, compressed backgrounds (public/backgrounds). One is picked at build time so the
// image is part of the server-rendered HTML instead of being fetched after first paint.
const backgroundImages = ["/backgrounds/bg-1.webp", "/backgrounds/bg-2.webp", "/backgrounds/bg-3.webp", "/backgrounds/bg-4.webp", "/backgrounds/bg-5.webp"];
const selectedImage = backgroundImages[Math.floor(Math.random() * backgroundImages.length)];
---

<div class="background-container">
	<div class="background-image" style={`background-image: url('${selectedImage}')`}></div>
	<div class="background-overlay"></div>
</div>

<style>
	.background-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}

	.background-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		transition: opacity 1s ease-in-out;
	}

	.background-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		backdrop-filter: blur(5px);
		background: radial-gradient(60% 60% at 50% 10%, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.08)), rgba(0, 0, 0, 0.8);
	}
</style>
