---
const localImages = ["/backgrounds/bg-1.webp", "/backgrounds/bg-2.webp", "/backgrounds/bg-3.webp", "/backgrounds/bg-4.webp", "/backgrounds/bg-5.webp"];
const fallbackImage = localImages[Math.floor(Math.random() * localImages.length)];
---

<div class="background-container" data-fallback={fallbackImage}>
	<div class="background-image background-live" id="bg-live"></div>
	<div class="background-overlay"></div>
</div>

<script>
	import { fetchWallpaper } from "../lib/api";

	const STORAGE_KEY = "s600:wallpaper:v2";
	const CACHE_NAME = "s600-wallpaper-v1";
	const MAX_AGE_MS = 24 * 60 * 60 * 1000;

	const container = document.querySelector<HTMLElement>(".background-container");
	const layer = document.getElementById("bg-live");

	const readStored = (): string | null => {
		try {
			const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
			return saved && typeof saved.url === "string" && Date.now() - saved.at < MAX_AGE_MS ? saved.url : null;
		} catch {
			return null;
		}
	};

	const store = (url: string) => {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify({ url, at: Date.now() }));
		} catch {
		}
	};

	const cachedSource = async (url: string): Promise<string> => {
		try {
			const cache = await caches.open(CACHE_NAME);
			let response = await cache.match(url);
			if (!response) {
				response = await fetch(url, { mode: "cors" });
				if (!response.ok) return url;
				await cache.put(url, response.clone());
				for (const request of await cache.keys()) if (request.url !== url) await cache.delete(request);
			}
			return URL.createObjectURL(await response.blob());
		} catch {
			return url;
		}
	};

	const show = (src: string) =>
		new Promise<boolean>((resolve) => {
			if (!layer) return resolve(false);
			const image = new Image();
			image.decoding = "async";
			image.onload = () => {
				layer.style.backgroundImage = `url('${src}')`;
				requestAnimationFrame(() => layer.classList.add("is-on"));
				resolve(true);
			};
			image.onerror = () => resolve(false);
			image.src = src;
		});

	const run = async () => {
		let url = readStored();
		if (!url) {
			url = await fetchWallpaper();
			if (url) store(url);
		}

		if (url && (await show(await cachedSource(url)))) return;

		const fallback = container?.dataset.fallback;
		if (fallback) await show(fallback);
	};

	if (readStored()) void run();
	else if ("requestIdleCallback" in window) (window as any).requestIdleCallback(run, { timeout: 2000 });
	else setTimeout(run, 300);
</script>

<style>
	.background-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}

	.background-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.background-live {
		opacity: 0;
		transition: opacity 1s ease-in-out;
	}

	.background-live.is-on {
		opacity: 1;
	}

	.background-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(60% 60% at 50% 10%, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.05)), rgba(0, 0, 0, 0.5);
	}
</style>
