---
---

<div id="spotify-root" class="h-full">
	<div class="skeleton h-80"></div>
</div>

<script>
	import { onSnapshot, pick, refresh, snapshotTime } from "../../lib/api";
	import { html, toHtml, clock, timeAgo } from "../../lib/format";
	import { observeReveals } from "../../lib/fx";

	const root = document.getElementById("spotify-root")!;

	let ticker: number | undefined;
	let last = "";

	const stopTicker = () => {
		window.clearInterval(ticker);
		ticker = undefined;
	};

	const view = (track: any, live: boolean, durationMs: number, progressMs: number, playedAt: string | null) => {
		const pct = durationMs ? Math.min(1, progressMs / durationMs) : 0;
		return html`
			<div class="card-shell-lg h-full" data-reveal>
				${track.image ? html`<div class="pointer-events-none absolute inset-0 z-0 opacity-30 blur-3xl saturate-150" style="background:url('${track.image}') center/cover"></div>` : ""}
				<div class="relative z-10 flex h-full flex-col justify-between gap-5 p-5 sm:p-6">
					<div class="flex items-center justify-between">
						<span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] ${live ? "text-emerald-300" : "text-white/50"}">
							<span class="eq ${live ? "" : "is-paused"}"><span></span><span></span><span></span><span></span></span>
							${live ? "Now playing" : "Last played"}
						</span>
						<i class="ph-fill ph-spotify-logo text-2xl text-emerald-400"></i>
					</div>

					<div class="flex items-center gap-4 sm:gap-5">
						<a href="${track.url}" target="_blank" rel="noopener noreferrer" class="lift group relative block h-28 w-28 shrink-0 overflow-hidden rounded-xl shadow-2xl sm:h-32 sm:w-32" data-tip="Open in Spotify">
							${track.image
								? html`<img src="${track.image}" alt="${track.album} cover" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" />`
								: html`<div class="flex h-full w-full items-center justify-center bg-white/10"><i class="ph ph-music-notes text-3xl"></i></div>`}
						</a>
						<div class="min-w-0">
							<a href="${track.url}" target="_blank" rel="noopener noreferrer" class="block truncate text-lg font-bold text-white hover:underline sm:text-xl">${track.title}</a>
							<p class="mt-1 truncate text-sm text-white/70">${track.artists}</p>
							<p class="mt-0.5 truncate text-xs text-white/40">${track.album}</p>
							${!live && playedAt ? html`<p class="mt-2 text-xs text-white/40">${timeAgo(playedAt)}</p>` : ""}
						</div>
					</div>

					<div>
						<div class="h-1.5 overflow-hidden rounded-full bg-white/15" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(pct * 100)}">
							<div id="sp-bar" class="h-full w-full origin-left rounded-full bg-emerald-300" style="transform:scaleX(${pct});transition:transform 1s linear"></div>
						</div>
						<div class="mt-1.5 flex justify-between font-mono text-[11px] text-white/45">
							<span id="sp-now">${clock(progressMs)}</span>
							<span>${clock(durationMs)}</span>
						</div>
					</div>
				</div>
			</div>
		`;
	};

	onSnapshot((snapshot, meta) => {
		const data = pick(snapshot, "spotify");
		const track = data?.playing ? data : data?.lastPlayed;

		if (!track?.title) {
			stopTicker();
			if (last === "error" || (!snapshot && !meta.error)) return;
			last = "error";
			root.innerHTML = `<div class="card-empty h-full"><p>Spotify is unavailable right now.</p><button id="sp-retry" class="btn-outline mt-4">Try again</button></div>`;
			root.querySelector("#sp-retry")?.addEventListener("click", () => void refresh(true));
			return;
		}

		stopTicker();

		const durationMs: number = track.duration ?? data.duration ?? 0;
		const anchor = snapshotTime(snapshot);
		const baseProgress: number = (data.playing ? data.progress : track.progress) ?? 0;

		// The reading is as old as the snapshot; advance it so the bar tracks the song, but stop
		// claiming "now playing" once the song would have finished.
		const projected = () => baseProgress + (anchor ? Date.now() - anchor : 0);
		const live = Boolean(data.playing) && (!durationMs || projected() < durationMs + 5000);

		const key = JSON.stringify([track.url, track.title, live, track.image]);
		if (key !== last) {
			last = key;
			const shown = live ? Math.min(durationMs || Infinity, projected()) : durationMs;
			root.innerHTML = toHtml(view(track, live, durationMs, shown, track.playedAt ?? null));
			observeReveals(root);
		}

		if (!live) return;

		const tick = () => {
			if (document.visibilityState !== "visible") return;
			const progress = Math.min(durationMs || Infinity, projected());
			const bar = document.getElementById("sp-bar");
			const now = document.getElementById("sp-now");
			if (bar && durationMs) bar.style.transform = `scaleX(${Math.min(1, progress / durationMs)})`;
			if (now) now.textContent = clock(progress);
			if (durationMs && projected() >= durationMs + 5000) {
				// The track has finished: re-evaluate now instead of waiting for the next poll.
				stopTicker();
				last = "";
				void refresh(true);
			}
		};

		tick();
		ticker = window.setInterval(tick, 1000);
	});
</script>
