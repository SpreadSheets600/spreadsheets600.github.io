---
const userId = import.meta.env.DISCORD_USER_ID || "727012870683885578";
---

<div class="mb-12">
	<!-- Desktop: Now Playing + Playlists side by side -->
	<div class="hidden lg:grid lg:grid-cols-4 gap-4 mb-6">
		<!-- Now Playing Card -->
		<div id="spotify-now-playing-container" data-user-id={userId} class="rounded-2xl border border-white/10 bg-black/40 py-4 px-5 backdrop-blur-xl lg:col-span-2">
			<h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
				<i class="ph ph-spotify-logo text-green-400"></i>
				Now Playing
			</h3>

			<!-- Loading State -->
			<div id="snp-loading" class="flex items-center gap-3">
				<div class="animate-spin rounded-full h-10 w-10 border-b-2 border-green-400"></div>
				<p class="text-white/60 text-sm">Connecting...</p>
			</div>

			<!-- Error State -->
			<div id="snp-error" class="hidden flex items-center gap-3">
				<i class="ph ph-warning-circle text-red-400 text-2xl"></i>
				<div>
					<p class="text-red-400 text-sm">Connection failed</p>
					<button id="snp-retry-btn" class="text-xs text-green-400 hover:text-green-300 underline">Retry</button>
				</div>
			</div>

			<!-- Idle State -->
			<div id="snp-idle" class="hidden flex items-center gap-3">
				<div class="w-12 h-12 bg-white/10 rounded-lg flex items-center justify-center">
					<i class="ph ph-pause text-white/40 text-xl"></i>
				</div>
				<div>
					<p class="text-white/60 text-sm">Not playing</p>
					<p class="text-xs text-white/40">Spotify is idle</p>
				</div>
			</div>

			<!-- Playing State -->
			<div id="snp-playing" class="hidden">
				<div class="flex items-center gap-3">
					<div class="relative w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden shadow-lg">
						<img id="snp-cover" src="" alt="Album" class="w-full h-full object-cover" />
						<div id="snp-no-cover" class="hidden absolute inset-0 bg-black/60 flex items-center justify-center">
							<i class="ph ph-music-note text-green-400 text-xl"></i>
						</div>
					</div>
					<div class="flex-1 min-w-0">
						<p id="snp-track" class="font-semibold text-white text-sm truncate"></p>
						<p id="snp-artist" class="text-xs text-white/60 truncate"></p>
					</div>
				</div>
				<div id="snp-progress-container" class="mt-3">
					<div class="h-1 bg-white/10 rounded-full overflow-hidden">
						<div id="snp-progress-bar" class="h-full bg-green-400 transition-all" style="width: 0%"></div>
					</div>
					<div class="flex justify-between text-xs text-white/40 mt-1">
						<span id="snp-current-time">0:00</span>
						<span id="snp-total-time">0:00</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Playlists (Desktop) -->
		<div id="playlists-desktop" class="lg:col-span-2 grid grid-cols-3 gap-2">
			<!-- Loading skeleton -->
			<div class="playlist-skeleton rounded-xl border border-white/10 bg-black/40 p-2 backdrop-blur-xl animate-pulse">
				<div class="w-full aspect-square bg-white/10 rounded-lg mb-2"></div>
				<div class="h-3 bg-white/10 rounded w-3/4 mb-1"></div>
				<div class="h-2.5 bg-white/10 rounded w-1/2"></div>
			</div>
			<div class="playlist-skeleton rounded-xl border border-white/10 bg-black/40 p-2 backdrop-blur-xl animate-pulse">
				<div class="w-full aspect-square bg-white/10 rounded-lg mb-2"></div>
				<div class="h-3 bg-white/10 rounded w-3/4 mb-1"></div>
				<div class="h-2.5 bg-white/10 rounded w-1/2"></div>
			</div>
			<div class="playlist-skeleton rounded-xl border border-white/10 bg-black/40 p-2 backdrop-blur-xl animate-pulse">
				<div class="w-full aspect-square bg-white/10 rounded-lg mb-2"></div>
				<div class="h-3 bg-white/10 rounded w-3/4 mb-1"></div>
				<div class="h-2.5 bg-white/10 rounded w-1/2"></div>
			</div>
		</div>
	</div>

	<!-- Mobile: Stack vertically -->
	<div class="lg:hidden space-y-4 mb-6">
		<!-- Now Playing Card (Mobile) -->
		<div id="spotify-now-playing-mobile" data-user-id={userId} class="rounded-2xl border border-white/10 bg-black/40 py-3 px-4 backdrop-blur-xl">
			<h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
				<i class="ph ph-spotify-logo text-green-400"></i>
				Now Playing
			</h3>

			<div id="snp-mobile-loading" class="flex items-center gap-3">
				<div class="animate-spin rounded-full h-10 w-10 border-b-2 border-green-400"></div>
				<p class="text-white/60 text-sm">Connecting...</p>
			</div>

			<div id="snp-mobile-error" class="hidden flex items-center gap-3">
				<i class="ph ph-warning-circle text-red-400 text-2xl"></i>
				<p class="text-red-400 text-sm">Connection failed</p>
			</div>

			<div id="snp-mobile-idle" class="hidden flex items-center gap-3">
				<div class="w-12 h-12 bg-white/10 rounded-lg flex items-center justify-center">
					<i class="ph ph-pause text-white/40 text-xl"></i>
				</div>
				<p class="text-white/60 text-sm">Not playing</p>
			</div>

			<div id="snp-mobile-playing" class="hidden">
				<div class="flex items-center gap-3">
					<div class="relative w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden">
						<img id="snp-mobile-cover" src="" alt="Album" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1 min-w-0">
						<p id="snp-mobile-track" class="font-semibold text-white text-sm truncate"></p>
						<p id="snp-mobile-artist" class="text-xs text-white/60 truncate"></p>
					</div>
				</div>
				<div class="mt-3">
					<div class="h-1 bg-white/10 rounded-full overflow-hidden">
						<div id="snp-mobile-progress-bar" class="h-full bg-green-400" style="width: 0%"></div>
					</div>
					<div class="flex justify-between text-xs text-white/40 mt-1">
						<span id="snp-mobile-current-time">0:00</span>
						<span id="snp-mobile-total-time">0:00</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Playlists (Mobile) -->
		<h3 class="text-lg font-semibold flex items-center gap-2 text-white">
			<i class="ph ph-playlist text-green-400"></i>
			My Playlists
		</h3>
		<div id="playlists-mobile" class="grid grid-cols-2 gap-2">
			<!-- Loading skeleton -->
			<div class="playlist-skeleton rounded-xl border border-white/10 bg-black/40 p-1.5 backdrop-blur-xl animate-pulse">
				<div class="w-full aspect-square bg-white/10 rounded-lg mb-2"></div>
				<div class="h-3 bg-white/10 rounded w-3/4"></div>
			</div>
			<div class="playlist-skeleton rounded-xl border border-white/10 bg-black/40 p-1.5 backdrop-blur-xl animate-pulse">
				<div class="w-full aspect-square bg-white/10 rounded-lg mb-2"></div>
				<div class="h-3 bg-white/10 rounded w-3/4"></div>
			</div>
			<div class="playlist-skeleton rounded-xl border border-white/10 bg-black/40 p-1.5 backdrop-blur-xl animate-pulse">
				<div class="w-full aspect-square bg-white/10 rounded-lg mb-2"></div>
				<div class="h-3 bg-white/10 rounded w-3/4"></div>
			</div>
		</div>
	</div>
</div>

<script>
	import { subscribeToLanyard, refreshLanyard } from "../../lib/status/lanyard.js";

	function formatTime(ms: number): string {
		if (!ms) return "0:00";
		const totalSeconds = Math.floor(ms / 1000);
		const minutes = Math.floor(totalSeconds / 60);
		const seconds = totalSeconds % 60;
		return `${minutes}:${seconds.toString().padStart(2, "0")}`;
	}

	// Desktop elements
	const container = document.getElementById("spotify-now-playing-container");
	// Mobile elements
	const mobileContainer = document.getElementById("spotify-now-playing-mobile");

	let progressInterval: ReturnType<typeof setInterval> | null = null;

	function setupNowPlaying(cont: HTMLElement, prefix: string) {
		const userId = cont.dataset.userId || "727012870683885578";

		const els = {
			loading: document.getElementById(`${prefix}-loading`),
			error: document.getElementById(`${prefix}-error`),
			idle: document.getElementById(`${prefix}-idle`),
			playing: document.getElementById(`${prefix}-playing`),
			retryBtn: document.getElementById(`${prefix}-retry-btn`),
			cover: document.getElementById(`${prefix}-cover`) as HTMLImageElement | null,
			noCover: document.getElementById(`${prefix}-no-cover`),
			track: document.getElementById(`${prefix}-track`),
			artist: document.getElementById(`${prefix}-artist`),
			progressBar: document.getElementById(`${prefix}-progress-bar`),
			currentTime: document.getElementById(`${prefix}-current-time`),
			totalTime: document.getElementById(`${prefix}-total-time`),
		};

		const hideAll = () => {
			els.loading?.classList.add("hidden");
			els.error?.classList.add("hidden");
			els.idle?.classList.add("hidden");
			els.playing?.classList.add("hidden");
		};

		const showLoading = () => {
			hideAll();
			els.loading?.classList.remove("hidden");
		};
		const showError = () => {
			hideAll();
			els.error?.classList.remove("hidden");
		};
		const showIdle = () => {
			hideAll();
			els.idle?.classList.remove("hidden");
		};
		const showPlaying = () => {
			hideAll();
			els.playing?.classList.remove("hidden");
		};

		return { userId, els, showLoading, showError, showIdle, showPlaying };
	}

	if (container) {
		const desktop = setupNowPlaying(container, "snp");
		const mobile = mobileContainer ? setupNowPlaying(mobileContainer, "snp-mobile") : null;

		const startProgress = (start: number, duration: number) => {
			if (progressInterval) clearInterval(progressInterval);
			const update = () => {
				let progress = Date.now() - start;
				if (progress > duration) progress = duration;
				const percent = (progress / duration) * 100;

				// Desktop
				if (desktop.els.progressBar) desktop.els.progressBar.style.width = `${percent}%`;
				if (desktop.els.currentTime) desktop.els.currentTime.textContent = formatTime(progress);
				if (desktop.els.totalTime) desktop.els.totalTime.textContent = formatTime(duration);

				// Mobile
				if (mobile?.els.progressBar) mobile.els.progressBar.style.width = `${percent}%`;
				if (mobile?.els.currentTime) mobile.els.currentTime.textContent = formatTime(progress);
				if (mobile?.els.totalTime) mobile.els.totalTime.textContent = formatTime(duration);
			};
			update();
			progressInterval = setInterval(update, 1000);
		};

		const handlePresence = (data: any) => {
			const spotify = data?.spotify;
			if (!spotify) {
				desktop.showIdle();
				mobile?.showIdle();
				if (progressInterval) clearInterval(progressInterval);
				return;
			}

			desktop.showPlaying();
			mobile?.showPlaying();

			// Desktop
			if (desktop.els.track) desktop.els.track.textContent = spotify.song || "";
			if (desktop.els.artist) desktop.els.artist.textContent = spotify.artist || "";
			if (desktop.els.cover && spotify.album_art_url) {
				desktop.els.cover.src = spotify.album_art_url;
			}

			// Mobile
			if (mobile?.els.track) mobile.els.track.textContent = spotify.song || "";
			if (mobile?.els.artist) mobile.els.artist.textContent = spotify.artist || "";
			if (mobile?.els.cover && spotify.album_art_url) {
				(mobile.els.cover as HTMLImageElement).src = spotify.album_art_url;
			}

			if (spotify.timestamps) {
				const duration = spotify.timestamps.end - spotify.timestamps.start;
				startProgress(spotify.timestamps.start, duration);
			}
		};

		desktop.els.retryBtn?.addEventListener("click", () => {
			desktop.showLoading();
			mobile?.showLoading();
			refreshLanyard(desktop.userId).catch(() => {
				desktop.showError();
				mobile?.showError();
			});
		});

		desktop.showLoading();
		mobile?.showLoading();

		subscribeToLanyard(desktop.userId, {
			onPresence: handlePresence,
			onError: () => {
				desktop.showError();
				mobile?.showError();
			},
		});
	}

	// Fetch playlists
	async function loadPlaylists() {
		const desktopContainer = document.getElementById("playlists-desktop");
		const mobileContainer = document.getElementById("playlists-mobile");

		try {
			const res = await fetch("/api/spotify-playlists?count=3");
			const data = await res.json();

			if (data.error || !data.playlists) {
				throw new Error(data.error || "No playlists");
			}

			const playlists = data.playlists;

			// Render desktop playlists
			if (desktopContainer) {
				desktopContainer.innerHTML = playlists
					.map(
						(p: any) => `
					<a href="${p.url}" target="_blank" rel="noopener noreferrer" 
					   class="rounded-xl border border-white/10 bg-black/40 p-2 backdrop-blur-xl hover:bg-black/50 transition-colors group">
						<div class="w-full aspect-square rounded-lg overflow-hidden mb-2 bg-white/10">
							${p.image ? `<img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />` : `<div class="w-full h-full flex items-center justify-center"><i class="ph ph-playlist text-4xl text-white/40"></i></div>`}
						</div>
						<p class="font-semibold text-white text-xs truncate">${p.name}</p>
						<p class="text-[11px] text-white/60">${p.tracks} tracks</p>
					</a>
				`,
					)
					.join("");
			}

			// Render mobile playlists
			if (mobileContainer) {
				mobileContainer.innerHTML = playlists
					.map(
						(p: any) => `
					<a href="${p.url}" target="_blank" rel="noopener noreferrer" 
					   class="rounded-xl border border-white/10 bg-black/40 p-1.5 backdrop-blur-xl hover:bg-black/50 transition-colors">
						<div class="w-full aspect-square rounded-lg overflow-hidden mb-2 bg-white/10">
							${p.image ? `<img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover" />` : `<div class="w-full h-full flex items-center justify-center"><i class="ph ph-playlist text-3xl text-white/40"></i></div>`}
						</div>
						<p class="font-medium text-white text-[11px] truncate">${p.name}</p>
						<p class="text-[10px] text-white/60">${p.tracks} tracks</p>
					</a>
				`,
					)
					.join("");
			}
		} catch (err) {
			// Show error state for playlists
			const errorHtml = `
				<div class="col-span-full text-center py-4">
					<i class="ph ph-warning-circle text-white/40 text-2xl mb-2"></i>
					<p class="text-white/60 text-sm">Could not load playlists</p>
				</div>
			`;
			if (desktopContainer) desktopContainer.innerHTML = errorHtml;
			if (mobileContainer) mobileContainer.innerHTML = errorHtml;
		}
	}

	loadPlaylists();
</script>
