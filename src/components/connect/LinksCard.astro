---
import {
	PhGithubLogo,
	PhTwitterLogo,
	PhLinkedinLogo,
	PhEnvelopeSimple,
	PhLinktreeLogo,
	PhInstagramLogo,
	PhYoutubeLogo,
	PhTiktokLogo,
	PhDiscordLogo,
	PhGlobe,
} from "phosphor-icons-astro";
import socialLinks from "../../data/social-links.json";

const iconMap = {
	github: PhGithubLogo,
	twitter: PhTwitterLogo,
	linkedin: PhLinkedinLogo,
	email: PhEnvelopeSimple,
	linktree: PhLinktreeLogo,
	instagram: PhInstagramLogo,
	youtube: PhYoutubeLogo,
	tiktok: PhTiktokLogo,
	discord: PhDiscordLogo,
	website: PhGlobe,
};

const links = (socialLinks?.links || [])
	.filter((link) => link && link.enabled !== false)
	.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

<div class="rounded-3xl border border-white/10 bg-black/40 p-5 sm:p-6 backdrop-blur-xl">
	<h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-4 sm:mb-6 flex items-center gap-2">
		<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
			<PhLinktreeLogo size={32} />
		</div>
		Social Links
	</h2>

	<div class="grid gap-3 sm:gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			links.map((link) => {
				const Icon = iconMap[link.icon] ?? PhLinktreeLogo;
				return (
					<a href={link.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 sm:gap-4 rounded-2xl border border-white/10 bg-black/30 p-3 sm:p-4 transition hover:bg-black/40 hover:border-white/20">
						<div class="flex w-8 h-8 sm:w-10 sm:h-10 items-center justify-center rounded-lg bg-white/10 flex-shrink-0">
							<Icon size={28} class={link.color || "text-white"} />
						</div>
						<div class="min-w-0 flex-1">
							<h3 class="font-semibold text-white text-sm sm:text-base truncate">{link.title}</h3>
							<p class="text-xs sm:text-sm text-white/60 truncate">{link.description}</p>
						</div>
					</a>
				);
			})
		}
	</div>
</div>
