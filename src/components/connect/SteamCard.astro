---
---

<div id="steam-root">
	<div class="skeleton h-96"></div>
</div>

<script>
	import { onSnapshot, pick, refresh } from "../../lib/api";
	import { html, toHtml, fmt, timeAgo } from "../../lib/format";
	import { observeReveals } from "../../lib/fx";

	const root = document.getElementById("steam-root")!;

	const STATUS_STYLE: Record<string, string> = {
		online: "bg-emerald-400",
		away: "bg-amber-400",
		busy: "bg-rose-500",
		snooze: "bg-amber-400",
		offline: "bg-slate-500",
	};

	/** SVG progress ring; fill is animated by .ring-fill when the section scrolls in. */
	const ring = (size: number, stroke: number, value: number, color: string) => {
		const r = (size - stroke) / 2;
		const len = 2 * Math.PI * r;
		return html`
			<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" class="-rotate-90" aria-hidden="true">
				<circle cx="${size / 2}" cy="${size / 2}" r="${r}" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="${stroke}" />
				<circle class="ring-fill" cx="${size / 2}" cy="${size / 2}" r="${r}" fill="none" stroke="${color}" stroke-width="${stroke}" stroke-linecap="round" style="--len:${len};--v:${Math.max(0, Math.min(1, value))}" />
			</svg>
		`;
	};

	const stat = (icon: string, label: string, value: number, i: number) => html`
		<div class="rounded-xl border border-white/10 bg-black/30 p-3" data-reveal style="--i:${i}">
			<div class="text-[10px] uppercase tracking-[0.14em] text-white/45">${label}</div>
			<p class="mt-1 text-xl font-bold text-white" data-count="${value}">0</p>
		</div>
	`;

	const gameList = (title: string, games: any[], valueOf: (g: any) => number, labelOf: (g: any) => string) => {
		const max = Math.max(...games.map(valueOf), 1);
		return html`
			<div>
				<h4 class="mb-3 text-[11px] uppercase tracking-[0.14em] text-white/45">${title}</h4>
				<ul class="space-y-3">
					${games.map(
						(game, i) => html`
							<li>
								<a href="https://store.steampowered.com/app/${game.appid}" target="_blank" rel="noopener noreferrer" class="lift flex items-center gap-3 rounded-lg" data-tip="${game.name}">
									<img src="https://cdn.cloudflare.steamstatic.com/steam/apps/${game.appid}/header.jpg" alt="" class="h-9 w-[72px] shrink-0 rounded-md bg-white/10 object-cover" loading="lazy" onerror="this.style.visibility='hidden'" />
									<div class="min-w-0 flex-1">
										<div class="flex justify-between gap-2 text-xs">
											<span class="truncate font-medium text-white/90">${game.name}</span>
											<span class="shrink-0 text-white/45">${labelOf(game)}</span>
										</div>
										<div class="mt-1 h-1 overflow-hidden rounded-full bg-white/10">
											<div class="bar-fill h-full rounded-full bg-sky-300" style="--v:${valueOf(game) / max};--d:${i}"></div>
										</div>
									</div>
								</a>
							</li>
						`,
					)}
				</ul>
			</div>
		`;
	};

	const view = (s: any) => {
		const a = s.achievements ?? {};
		// Steam levels need 100 XP per step, plus another 100 for every ten levels reached.
		const step = 100 * (Math.floor(s.level / 10) + 1);
		const levelProgress = s.xpNeeded > 0 && s.xpNeeded <= step ? 1 - s.xpNeeded / step : 0;
		const inGame = s.game;

		return html`
			<div class="card-shell-lg card-pad sm:p-6" data-reveal>
				<div class="relative z-10 flex flex-wrap items-center justify-between gap-4">
					<div class="flex items-center gap-4">
						<div class="relative h-[84px] w-[84px] shrink-0">
							<div class="absolute inset-0">${ring(84, 4, levelProgress, "#7dd3fc")}</div>
							<img src="${s.avatar}" alt="" class="absolute inset-[7px] h-[70px] w-[70px] rounded-full object-cover" loading="lazy" />
						</div>
						<div>
							<div class="flex items-center gap-2">
								<h3 class="text-xl font-bold text-white">${s.name}</h3>
								<span class="rounded-full border border-sky-300/40 bg-sky-300/10 px-2 py-0.5 text-[11px] font-bold text-sky-200" data-tip="${s.xpNeeded} XP to level ${s.level + 1}">Lv ${s.level}</span>
								<span class="h-2.5 w-2.5 rounded-full ${STATUS_STYLE[s.status] ?? STATUS_STYLE.offline}" data-tip="${s.status}"></span>
							</div>
							<p class="text-sm text-white/55">${inGame ? html`Playing <span class="text-emerald-300">${inGame}</span>` : s.latestPlayed ? html`Last played <span class="text-white/80">${s.latestPlayed.name}</span>` : "Steam"}</p>
							<p class="mt-0.5 text-xs text-white/35">${s.badges} badges${s.country ? ` · ${s.country}` : ""}</p>
						</div>
					</div>
					<a href="${s.profileUrl}" target="_blank" rel="noopener noreferrer" class="btn-outline">Steam profile <i class="ph ph-arrow-up-right"></i></a>
				</div>

				<div class="relative z-10 mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					${stat("ph-game-controller", "Games", s.ownedGames, 0)}
					${stat("ph-clock", "Hours played", s.totalHours, 1)}
					${stat("ph-stack", "Backlog", s.backlog, 2)}
					${stat("ph-trophy", "Perfect games", a.perfect ?? 0, 3)}
				</div>

				<div class="relative z-10 mt-6 grid gap-8 lg:grid-cols-3">
					${gameList("Recently played · 2 weeks", s.recent ?? [], (g) => g.minutes, (g) => `${Math.round(g.minutes / 60)}h recent · ${Math.round(g.totalMinutes / 60)}h total`)}
					${gameList("Most played", s.topGames ?? [], (g) => g.minutes, (g) => `${fmt(g.hours)}h`)}

					<div>
						<h4 class="mb-3 text-[11px] uppercase tracking-[0.14em] text-white/45">Achievements</h4>
						<div class="flex items-center gap-4">
							<div class="relative h-[84px] w-[84px] shrink-0">
								${ring(84, 7, (a.percent ?? 0) / 100, "#fbbf24")}
								<div class="absolute inset-0 flex flex-col items-center justify-center">
									<span class="text-lg font-bold text-white" data-count="${a.percent ?? 0}" data-decimals="0" data-suffix="%">0%</span>
								</div>
							</div>
							<p class="text-xs text-white/55">${fmt(a.unlocked)} of ${fmt(a.total)} unlocked across the ${a.checked ?? 0} games checked</p>
						</div>
						${a.latest
							? html`<div class="mt-4 rounded-lg border border-white/10 bg-black/30 p-3 text-xs"><p class="text-[10px] uppercase tracking-[0.14em] text-white/40">Latest</p><p class="mt-0.5 font-semibold text-white">${a.latest.name}</p><p class="text-white/45">${a.latest.game} · ${timeAgo(a.latest.unlockedAt)}</p></div>`
							: ""}
						${a.rarest
							? html`<div class="mt-2 rounded-lg border border-amber-300/20 bg-amber-300/5 p-3 text-xs"><p class="text-[10px] uppercase tracking-[0.14em] text-amber-200/70">Rarest · ${a.rarest.percent}% of players</p><p class="mt-0.5 font-semibold text-white">${a.rarest.name}</p><p class="text-white/45">${a.rarest.game}</p></div>`
							: ""}
					</div>
				</div>
			</div>
		`;
	};

	let last = "";

	onSnapshot((snapshot, meta) => {
		const s = pick(snapshot, "steam");

		if (!s) {
			if (last === "error" || (!snapshot && !meta.error)) return;
			last = "error";
			root.innerHTML = `<div class="card-empty"><p>Steam is unavailable right now.</p><button id="steam-retry" class="btn-outline mt-4">Try again</button></div>`;
			root.querySelector("#steam-retry")?.addEventListener("click", () => void refresh(true));
			return;
		}

		const key = JSON.stringify(s);
		if (key === last) return;
		last = key;

		root.innerHTML = toHtml(view(s));
		observeReveals(root);
	});
</script>
