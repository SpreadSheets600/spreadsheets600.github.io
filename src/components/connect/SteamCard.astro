---
interface Props {
	steamId?: string;
	vanity?: string;
}

const { steamId, vanity } = Astro.props;
---

<div id="steam-status-container" data-steam-id={steamId} data-vanity={vanity} class="card-shell-lg card-pad relative">
	<div class="flex flex-wrap items-center justify-between gap-4 mb-5">
		<div class="flex items-center gap-3">
			<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-white">
				<i class="ph ph-steam-logo text-2xl"></i>
			</div>
			<div>
				<h3 class="text-lg font-semibold text-white">Steam Status</h3>
			</div>
		</div>
		<a id="steam-profile-link" href="https://steamcommunity.com/id/Sheetsie/" target="_blank" rel="noopener noreferrer" class="btn-outline">
			View Profile <i class="ph ph-arrow-square-out"></i>
		</a>
	</div>

	<div id="steam-loading" class="card-skeleton flex items-center justify-center space-x-3 py-10">
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-400"></div>
		<span class="text-white/80 text-sm sm:text-base">Connecting to Steam...</span>
	</div>

	<div id="steam-error" class="card-empty hidden">
		<div class="text-red-400 flex flex-col items-center justify-center space-y-3">
			<i class="ph ph-warning-circle text-4xl"></i>
			<span class="text-lg font-semibold">Steam unavailable</span>
			<p id="steam-error-message" class="text-white/60 text-sm">Missing Steam API configuration.</p>
		</div>
		<button id="steam-retry-btn" class="mt-5 text-blue-300 hover:text-blue-200 text-sm underline transition-colors">Try again</button>
	</div>

	<div id="steam-content" class="hidden space-y-5">
		<div class="card-shell p-4 sm:p-5">
			<div class="flex items-center gap-4">
				<div class="relative flex-shrink-0">
					<div class="relative w-16 h-16 sm:w-20 sm:h-20">
						<img id="steam-avatar" src="" alt="Steam avatar" class="absolute inset-0 w-full h-full rounded-full object-cover" />
					</div>
					<span id="steam-status-indicator" class="absolute -bottom-1 -right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full border-[5px] border-black"></span>
				</div>
				<div class="flex-1 min-w-0 space-y-1">
					<p id="steam-name" class="text-white font-bold text-xl sm:text-2xl truncate"></p>
					<p id="steam-vanity" class="text-white/60 text-sm sm:text-base truncate"></p>
				</div>
			</div>
		</div>

		<div id="steam-currently-playing" class="card-shell hidden p-4 flex items-center gap-4">
			<img id="steam-currently-image" class="w-16 h-10 sm:w-20 sm:h-12 rounded-lg object-cover" alt="Currently playing" />
			<div class="flex-1 min-w-0">
				<p class="text-xs uppercase tracking-[0.3em] text-white/50">Now Playing</p>
				<p id="steam-currently-name" class="text-white font-semibold truncate"></p>
			</div>
			<span class="rounded-full bg-green-500/20 text-green-200 text-xs px-2.5 py-1 border border-green-500/40">Live</span>
		</div>

		<div class="grid grid-cols-2 gap-3">
			<div class="card-shell p-3 text-center">
				<p id="steam-total-games" class="text-lg font-semibold text-white">0</p>
				<p class="text-xs uppercase tracking-wide text-white/50">Games Owned</p>
			</div>
			<div class="card-shell p-3 text-center">
				<p id="steam-total-hours" class="text-lg font-semibold text-white">0</p>
				<p class="text-xs uppercase tracking-wide text-white/50">Hours Played</p>
			</div>
		</div>

		<div>
			<div id="steam-recent-list" class="space-y-3"></div>
			<div id="steam-no-activity" class="card-shell hidden p-4 text-center text-white/60 text-sm">No recent activity.</div>
		</div>
	</div>
</div>

<script>
	import { init } from "../../lib/status/steam.js";

	const container = document.getElementById("steam-status-container");
	if (container) init(container);
</script>
