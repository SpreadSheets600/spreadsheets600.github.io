---
interface Props {
	project: {
		name: string;
		html_url: string;
		topics: string[];
		forks_count?: number;
		homepage: string | null;
		language: string | null;
		stargazers_count?: number;
		description: string | null;
		image?: string | null;
	};
}

const { project } = Astro.props;

import { getLanguageColor } from "../lib/languageColors.js";

const langColor = getLanguageColor(project.language);
---

<article class="group card-shell flex flex-col py-3 px-4 sm:py-4 sm:px-6 hover:-translate-y-1 hover:bg-black/50">
	{
		project.image && (
			<div class="mb-4 overflow-hidden rounded-xl border border-white/10 bg-white/5">
				<img src={project.image} alt={`${project.name} preview`} loading="lazy" class="h-36 w-full object-cover" />
			</div>
		)
	}

	<div class="flex items-center gap-3 mb-3">
		<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
			<i class="ph-light ph-folder-open text-2xl"></i>
		</div>
		<h3 class="text-base sm:text-lg font-semibold truncate flex-1">{project.name}</h3>
	</div>

	<p class="text-xs sm:text-sm text-white/75 mb-4 flex-1 line-clamp-2">
		{project.description || "No description available"}
	</p>

	{
		project.topics.length > 0 && (
			<div class="flex flex-wrap gap-1.5 mb-4">
				{project.topics.slice(0, 4).map((topic) => (
					<span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/70">{topic}</span>
				))}
			</div>
		)
	}

	<div class="flex items-center justify-between mt-auto pt-3 border-t border-white/5">
		<div class="flex items-center gap-4 text-xs sm:text-sm text-white/60">
			{
				project.language && (
					<span class="flex items-center gap-1.5">
						<span class="w-2.5 h-2.5 rounded-full" style={`background: ${langColor};`} />
						{project.language}
					</span>
				)
			}
			{
				project.stargazers_count !== undefined && project.stargazers_count > 0 && (
					<span class="flex items-center gap-1">
						<i class="ph ph-star" />
						{project.stargazers_count}
					</span>
				)
			}
			{
				project.forks_count !== undefined && project.forks_count > 0 && (
					<span class="flex items-center gap-1">
						<i class="ph ph-git-fork" />
						{project.forks_count}
					</span>
				)
			}
		</div>

		<div class="flex gap-2">
			<a href={project.html_url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-lg bg-white/15 px-3 py-1.5 text-xs sm:text-sm font-medium text-white hover:bg-white/20 transition">
				<i class="ph ph-github-logo"></i>
				Code
			</a>
			{
				project.homepage && (
					<a href={project.homepage} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-lg border border-white/20 px-3 py-1.5 text-xs sm:text-sm font-medium text-white hover:bg-white/10 transition">
						<i class="ph ph-arrow-square-out" />
						Demo
					</a>
				)
			}
		</div>
	</div>
</article>
