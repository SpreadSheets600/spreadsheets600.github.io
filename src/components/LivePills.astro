---
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["live-pills flex flex-wrap items-center gap-2", className]} aria-live="polite">
	<span class="skeleton h-7 w-40 rounded-full"></span>
	<span class="skeleton h-7 w-56 rounded-full"></span>
</div>

<script>
	import { onSnapshot, pick, snapshotTime } from "../lib/api";
	import { html, toHtml, timeAgo } from "../lib/format";

	const DOT: Record<string, string> = {
		online: "bg-emerald-400",
		idle: "bg-amber-400",
		dnd: "bg-rose-500",
		offline: "bg-slate-500",
	};

	const LABEL: Record<string, string> = { online: "Online", idle: "Idle", dnd: "Busy", offline: "Offline" };

	const pillClass = "lift inline-flex max-w-full items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-1.5 text-xs text-white/80 backdrop-blur-md hover:border-white/25";

	const render = (snapshot: any) => {
		const discord = pick(snapshot, "discord");
		const spotify = pick(snapshot, "spotify");
		const presence = discord?.presence;
		const track = spotify?.playing ? spotify : spotify?.lastPlayed;
		const parts: ReturnType<typeof html>[] = [];

		if (presence) {
			const status = presence.status in DOT ? presence.status : "offline";
			const doing = presence.activity?.name ? `${presence.activity.kind === "playing" ? "Playing" : presence.activity.kind} ${presence.activity.name}` : LABEL[status];
			const id = discord.profile?.user?.id;
			parts.push(html`
				<a href="${id ? `https://discord.com/users/${id}` : "/connect"}" target="_blank" rel="noopener noreferrer" class="${pillClass}" data-tip="Discord · ${LABEL[status]}">
					<span class="relative h-2 w-2 rounded-full ${DOT[status]} ${status === "online" ? "ping-dot" : ""}"></span>
					<span class="truncate">${doing}</span>
				</a>
			`);
		}

		if (track?.title) {
			const live = Boolean(spotify.playing);
			parts.push(html`
				<a href="${track.url}" target="_blank" rel="noopener noreferrer" class="${pillClass}" data-tip="${live ? "Listening now on Spotify" : `Last played ${timeAgo(track.playedAt ?? snapshotTime(snapshot))}`}">
					<span class="eq ${live ? "text-emerald-300" : "is-paused text-white/50"}"><span></span><span></span><span></span><span></span></span>
					<span class="truncate">${track.title}<span class="text-white/45"> · ${track.artists}</span></span>
				</a>
			`);
		}

		return parts;
	};

	let last = "";

	onSnapshot((snapshot) => {
		if (!snapshot) return;
		const parts = render(snapshot);
		if (parts.length === 0) return;

		const markup = parts.map(toHtml).join("");
		if (markup === last) return;
		last = markup;
		document.querySelectorAll(".live-pills").forEach((el) => (el.innerHTML = markup));
	});
</script>
