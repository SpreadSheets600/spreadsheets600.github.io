---
---

<div id="discord-status-container" class="w-full space-y-4">
  <!-- Loading State -->
  <div id="discord-loading" class="flex items-center justify-center space-x-3 py-12 bg-gray-900/60 rounded-2xl border border-gray-800">
    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-400"></div>
    <span class="text-gray-300 text-lg">Connecting to Discord...</span>
  </div>

  <!-- Error State -->
  <div id="discord-error" class="hidden text-center py-12 bg-gray-900/60 rounded-2xl border border-gray-800">
    <div class="text-red-400 flex flex-col items-center justify-center space-y-3">
      <i class="ph ph-warning-circle text-5xl"></i>
      <span class="text-xl font-semibold">Discord unavailable</span>
      <p class="text-gray-400 text-sm">Could not connect to Lanyard API.</p>
    </div>
    <button id="discord-retry-btn" class="mt-6 text-blue-400 hover:text-blue-300 text-sm underline transition-colors">Try again</button>
  </div>

  <!-- Content State -->
  <div id="discord-content" class="hidden space-y-4">
    <div class="grid gap-4">
      <!-- Profile Card -->
      <div class="w-full bg-gradient-to-br from-gray-900/80 via-gray-900/60 to-gray-800/70 rounded-2xl border border-gray-800 shadow-2xl p-5 flex flex-col gap-4">
        <div class="flex items-center gap-4">
          <div class="relative flex-shrink-0">
            <div class="relative w-20 h-20">
              <img id="discord-avatar-decoration" class="absolute inset-0 w-full h-full pointer-events-none z-10 scale-[1.25] hidden" />
              <img id="discord-avatar" class="absolute inset-0 w-full h-full rounded-full object-cover ring-2 ring-offset-2 ring-offset-gray-900" />
            </div>
            <div id="discord-status-indicator" class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full border-4 border-gray-900 z-30"></div>
          </div>
          <div class="flex-1 min-w-0 space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 id="discord-name" class="text-white font-bold text-2xl truncate"></h3>
              <div id="discord-clan-tag" class="hidden flex items-center space-x-1 bg-purple-600/40 text-white text-xs px-2 py-1 rounded-full border border-purple-500/60">
                <img id="discord-clan-badge" class="w-4 h-4 hidden" />
                <span id="discord-clan-text"></span>
              </div>
            </div>
            <p id="discord-username" class="text-gray-400 text-base truncate"></p>
          </div>
        </div>
      </div>

      <!-- Activity Card -->
      <div class="w-full bg-gradient-to-br from-gray-900/80 via-gray-900/60 to-gray-800/70 rounded-2xl border border-gray-800 shadow-2xl p-5 flex flex-col gap-4">
        <!-- Custom Status -->
        <div id="discord-custom-status" class="hidden bg-gray-800/70 rounded-lg p-3 border border-gray-700/70 text-center">
          <p class="text-gray-200 text-sm flex items-center justify-center gap-2">
            <span id="discord-custom-emoji" class="text-lg hidden"></span>
            <span id="discord-custom-text" class="truncate"></span>
          </p>
        </div>

        <!-- Activities List -->
        <div id="discord-activities-list" class="space-y-3">
          <!-- Filled by JS -->
        </div>

        <div id="discord-no-activity" class="hidden text-gray-500 text-sm bg-gray-800/60 border border-gray-700/60 rounded-lg p-4 text-center">No active sessions.</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { fetchUserImages, decodeUserFlags } from "../../utils/imageUtils.js";

  const USER_ID = "727012870683885578"; // Hardcoded from Vue file
  let presence = null;
  let intervalId;

  const els = {
    loading: document.getElementById('discord-loading'),
    error: document.getElementById('discord-error'),
    content: document.getElementById('discord-content'),
    retryBtn: document.getElementById('discord-retry-btn'),

    avatar: document.getElementById('discord-avatar'),
    avatarDecoration: document.getElementById('discord-avatar-decoration'),
    statusIndicator: document.getElementById('discord-status-indicator'),
    name: document.getElementById('discord-name'),
    username: document.getElementById('discord-username'),
    clanTag: document.getElementById('discord-clan-tag'),
    clanBadge: document.getElementById('discord-clan-badge'),
    clanText: document.getElementById('discord-clan-text'),

    customStatus: document.getElementById('discord-custom-status'),
    customEmoji: document.getElementById('discord-custom-emoji'),
    customText: document.getElementById('discord-custom-text'),

    activitiesList: document.getElementById('discord-activities-list'),
    noActivity: document.getElementById('discord-no-activity'),
  };

  async function init() {
    els.retryBtn?.addEventListener('click', fetchPresence);
    await fetchPresence();

    // Update times every second
    intervalId = setInterval(updateTimes, 1000);
  }

  async function fetchPresence() {
    if (els.loading) els.loading.classList.remove('hidden');
    if (els.error) els.error.classList.add('hidden');
    if (els.content) els.content.classList.add('hidden');

    try {
      const response = await fetch(`https://api.lanyard.rest/v1/users/${USER_ID}`);
      const data = await response.json();

      if (data.success) {
        presence = data.data;
        await updateUI();
        if (els.loading) els.loading.classList.add('hidden');
        if (els.content) els.content.classList.remove('hidden');
        connectWebSocket(); // Connect for real-time updates
      } else {
        throw new Error('Lanyard API error');
      }
    } catch (err) {
      if (els.loading) els.loading.classList.add('hidden');
      if (els.error) els.error.classList.remove('hidden');
    }
  }

  function connectWebSocket() {
    const ws = new WebSocket("wss://api.lanyard.rest/socket");

    ws.onopen = () => {
      // console.log("Connected to Lanyard WebSocket");
    };

    ws.onmessage = (event) => {
      const data = JSON.parse(event.data);

      switch (data.op) {
        case 1: // Hello
          setInterval(() => {
            if (ws.readyState === WebSocket.OPEN) {
              ws.send(JSON.stringify({ op: 3 }));
            }
          }, data.d.heartbeat_interval);

          ws.send(JSON.stringify({
            op: 2,
            d: { subscribe_to_id: USER_ID },
          }));
          break;

        case 0: // Event
          if (data.t === "INIT_STATE" || data.t === "PRESENCE_UPDATE") {
             presence = data.d;
             updateUI();
          }
          break;
      }
    };
  }

  async function updateUI() {
    if (!presence) return;

    const images = await fetchUserImages(presence);

    // Profile
    if (els.avatar) {
      els.avatar.src = images.avatar;
      const statusColor = getStatusColor(presence.discord_status);
      els.avatar.className = `absolute inset-0 w-full h-full rounded-full object-cover ring-2 ring-offset-2 ring-offset-gray-900 ring-${statusColor}-500/60`;
    }

    if (els.avatarDecoration) {
      if (images.avatarDecoration) {
        els.avatarDecoration.src = images.avatarDecoration;
        els.avatarDecoration.classList.remove('hidden');
      } else {
        els.avatarDecoration.classList.add('hidden');
      }
    }

    if (els.statusIndicator) {
      const statusColor = getStatusColor(presence.discord_status);
      els.statusIndicator.className = `absolute -bottom-1 -right-1 w-6 h-6 rounded-full border-4 border-gray-900 z-30 bg-${statusColor}-500`;
    }

    if (els.name) els.name.textContent = presence.discord_user.display_name;
    if (els.username) els.username.textContent = presence.discord_user.username;

    if (els.clanTag) {
      if (presence.discord_user.primary_guild?.tag) {
        els.clanTag.classList.remove('hidden');
        if (els.clanText) els.clanText.textContent = presence.discord_user.primary_guild.tag;
        if (images.clanBadge && els.clanBadge) {
          els.clanBadge.src = images.clanBadge;
          els.clanBadge.classList.remove('hidden');
        } else if (els.clanBadge) {
          els.clanBadge.classList.add('hidden');
        }
      } else {
        els.clanTag.classList.add('hidden');
      }
    }

    // Activities
    const activities = presence.activities || [];
    const customStatus = activities.find(a => a.type === 4);
    const otherActivities = activities.filter(a => a.type !== 4 && a.name !== "Spotify");

    // Custom Status
    if (els.customStatus) {
      if (customStatus && (customStatus.state || customStatus.emoji)) {
        els.customStatus.classList.remove('hidden');
        if (els.customEmoji && customStatus.emoji) {
          els.customEmoji.textContent = customStatus.emoji.name;
          els.customEmoji.classList.remove('hidden');
        } else if (els.customEmoji) {
           els.customEmoji.classList.add('hidden');
        }

        if (els.customText) {
          els.customText.textContent = customStatus.state || "";
        }
      } else {
        els.customStatus.classList.add('hidden');
      }
    }

    // Activities List
    if (otherActivities.length > 0) {
      if (els.noActivity) els.noActivity.classList.add('hidden');
      if (els.activitiesList) {
        els.activitiesList.innerHTML = otherActivities.map(activity => {
          const mainActivity = activities.find(a => a.type === 0);
          const isMain = mainActivity?.id === activity.id;

          let iconHtml = '';
          if (images.assetLargeImage && isMain) {
             iconHtml = `<img src="${images.assetLargeImage}" class="w-16 h-16 rounded-lg object-cover" alt="${activity.name}" />`;
          } else {
             // Fallback icons using Phosphor classes
             const iconClass = getActivityIconClass(activity.type);
             iconHtml = `<i class="ph ${iconClass} text-blue-400 text-3xl w-16 text-center"></i>`;
          }

          let smallImageHtml = '';
          if (images.assetSmallImage && isMain) {
             smallImageHtml = `<img src="${images.assetSmallImage}" class="w-6 h-6 rounded-full absolute -bottom-2 -right-2 border-2 border-gray-800" />`;
          }

          let elapsedHtml = '';
          if (activity.timestamps?.start) {
            const startTime = activity.timestamps.start;
            elapsedHtml = `<p class="text-xs text-gray-500 activity-timer" data-start="${startTime}">00:00:00 elapsed</p>`;
          }

          return `
            <div class="bg-gray-800/70 rounded-lg p-4 border border-gray-700/70 flex items-center gap-4">
              <div class="flex-shrink-0 relative">
                ${iconHtml}
                ${smallImageHtml}
              </div>
              <div class="min-w-0 space-y-1">
                <p class="text-white font-semibold truncate">${activity.name}</p>
                ${activity.details ? `<p class="text-gray-300 text-sm truncate">${activity.details}</p>` : ''}
                ${activity.state ? `<p class="text-gray-400 text-sm truncate">${activity.state}</p>` : ''}
                ${elapsedHtml}
              </div>
            </div>
          `;
        }).join('');
        updateTimes(); // Initial update for new elements
      }
    } else {
      if (els.activitiesList) els.activitiesList.innerHTML = '';
      if (els.noActivity) els.noActivity.classList.remove('hidden');
    }
  }

  function getStatusColor(status) {
    const colorMap = {
      online: "green",
      idle: "yellow",
      dnd: "red",
      offline: "gray",
    };
    return colorMap[status] || "gray";
  }

  function getActivityIconClass(type) {
    const icons = {
      0: "ph-game-controller",
      1: "ph-broadcast",
      2: "ph-music-note",
      3: "ph-television",
      5: "ph-trophy",
    };
    return icons[type] || "ph-circle";
  }

  function updateTimes() {
    const timers = document.querySelectorAll('.activity-timer');
    const now = Date.now();
    timers.forEach(timer => {
       const start = parseInt(timer.getAttribute('data-start'));
       if (!isNaN(start)) {
         const diff = now - start;
         const hours = Math.floor(diff / (1000 * 60 * 60)).toString().padStart(2, "0");
         const minutes = Math.floor((diff / (1000 * 60)) % 60).toString().padStart(2, "0");
         const seconds = Math.floor((diff / 1000) % 60).toString().padStart(2, "0");
         timer.textContent = `${hours}:${minutes}:${seconds} elapsed`;
       }
    });
  }

  // Initialize on client side
  if (typeof window !== 'undefined') {
    init();
  }
</script>
