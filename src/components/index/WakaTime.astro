---
const skeletonList = Array(5).fill(0);
---

<section id="stats" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex items-center gap-3">
		<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
			<i class="ph-light ph-brackets-curly text-2xl"></i>
		</div>
		<h2 class="text-2xl font-bold text-white">Coding Stats</h2>
	</div>

	<div class="grid gap-4 sm:grid-cols-3">
		<article class="card-shell flex flex-col justify-between">
			<header class="card-header">
				<h3 class="text-sm font-semibold text-white/90 tracking-wide">Total Time</h3>
			</header>

			<section class="flex-1 p-4">
				<div id="waka-total" class="mt-1">
					<div class="h-6 w-24 animate-pulse rounded bg-white/10"></div>
				</div>
				<p id="waka-range" class="mt-2 text-sm text-white/30 truncate">Loading...</p>
			</section>
		</article>

		<article class="card-shell flex flex-col justify-between">
			<header class="card-header">
				<h3 class="text-sm font-semibold text-white/90 tracking-wide">Daily Average</h3>
			</header>

			<section class="flex-1 p-4">
				<div id="waka-daily" class="mt-1">
					<div class="h-6 w-16 animate-pulse rounded bg-white/10"></div>
				</div>
				<p class="mt-2 text-sm text-white/30">Last 7 Days</p>
			</section>
		</article>

		<article class="card-shell flex flex-col justify-between">
			<header class="card-header flex items-center justify-between">
				<h3 class="text-sm font-semibold text-white/90 tracking-wide">Today</h3>
				<div id="waka-status-dot" class="h-2 w-2 rounded-full bg-white/20 animate-pulse"></div>
			</header>

			<section class="flex-1 p-4">
				<div id="waka-today" class="mt-1">
					<div class="h-6 w-16 animate-pulse rounded bg-white/10"></div>
				</div>
				<p id="waka-today-date" class="mt-2 text-sm text-white/30">Since Midnight</p>
			</section>
		</article>
	</div>

	<div class="mt-4 grid gap-4 lg:grid-cols-3">
		{
			[
				{ id: "waka-os", icon: "ph-desktop", title: "Operating System" },
				{ id: "waka-lang", icon: "ph-code-block", title: "Top Languages" },
				{ id: "waka-editor", icon: "ph-terminal-window", title: "Code Editors" },
			].map((section) => (
				<article class="card-shell flex flex-col">
					<header class="card-header flex items-center gap-2">
						<i class={`${section.icon} text-white/70 text-lg`} />
						<h3 class="text-sm font-semibold text-white/90 tracking-wide">{section.title}</h3>
					</header>

					<section class="p-4">
						<div id={section.id} class="flex flex-col gap-3">
							{skeletonList.map(() => (
								<div class="flex flex-col gap-2">
									<div class="flex justify-between">
										<div class="h-3 w-24 animate-pulse rounded bg-white/10" />
										<div class="h-3 w-8 animate-pulse rounded bg-white/10" />
									</div>
									<div class="h-1.5 w-full animate-pulse rounded-full bg-white/5" />
								</div>
							))}
						</div>
					</section>
				</article>
			))
		}
	</div>
</section>

<script>
	async function initWakaTime() {
		try {
			const urls = {
				editors: "https://wakatime.com/share/@SpreadSheets600/d13c536f-1f9d-40a6-8bd5-ec5902652383.json",
				stats: "https://wakatime.com/share/@SpreadSheets600/6f79156a-5f87-43a8-9a05-0edd976b8c9a.json",
				langs: "https://wakatime.com/share/@SpreadSheets600/322b4068-62e5-430c-bfa2-cc92e8f7e7e3.json",
				today: "https://wakatime.com/share/@SpreadSheets600/9ce6920b-5ae7-4f33-90fd-f18d82f3aeb9.json",
				os: "https://wakatime.com/share/@SpreadSheets600/d3bada79-4d56-4544-8240-c9c6ff7a669d.json",
			};

			const [editors, stats, langs, today, os] = await Promise.all(Object.values(urls).map((url) => fetch(url).then((r) => r.json())));

			const setText = (id: string, text: string) => {
				const el = document.getElementById(id);

				if (el) el.innerHTML = `<span class="text-2xl font-bold text-white tracking-tight">${text}</span>`;
			};

			const setList = (id: string, data: any[] | undefined) => {
				const el = document.getElementById(id);
				if (!el || !data) return;

				el.innerHTML = data
					.slice(0, 5)
					.map(
						(item) => `
          <div class="group/item flex flex-col gap-3 rounded-lg transition-colors">
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium text-white/90 truncate mr-2">${item.name}</span>
              <span class="text-white/50 shrink-0">${item.text}</span>
            </div>
            <div class="bg-white/10 relative h-0.5 w-full overflow-hidden rounded-full">
              <div class="bg-white h-full transition-all duration-1000 ease-out" style="width: ${item.percent}%"></div>
            </div>
          </div>
        `,
					)
					.join("");
			};

			if (stats.data) {
				setText("waka-total", stats.data.grand_total.human_readable_total_including_other_language);
				setText("waka-daily", stats.data.grand_total.human_readable_daily_average_including_other_language);

				const start = new Date(stats.data.range.start).toLocaleDateString(undefined, { month: "short", day: "numeric" });
				const end = new Date(stats.data.range.end).toLocaleDateString(undefined, { month: "short", day: "numeric" });
				const rangeEl = document.getElementById("waka-range");
				if (rangeEl) rangeEl.innerText = `${start} - ${end}`;
			}

			if (today.data) {
				let tText = "0 mins";
				if (Array.isArray(today.data)) {
					const dateStr = new Date().toISOString().slice(0, 10);
					const todayEntry = today.data.find((d: any) => d.range.date === dateStr);

					if (todayEntry) tText = todayEntry.grand_total.text;
				} else {
					tText = today.data.text || "0 mins";
				}
				setText("waka-today", tText);

				if (tText !== "0 secs" && tText !== "0 mins") {
					const dot = document.getElementById("waka-status-dot");
					if (dot instanceof HTMLElement) {
						dot.classList.remove("bg-white/20", "animate-pulse");
						dot.classList.add("bg-emerald-500", "shadow-[0_0_8px_rgba(16,185,129,0.5)]");
					}
				}
			}

			setList("waka-os", os.data);
			setList("waka-lang", langs.data);
			setList("waka-editor", editors.data);
		} catch (err) {
			console.error("Stats Failed To Load", err);

			const setErrorText = (id: string, text = "Unavailable") => {
				const el = document.getElementById(id);
				if (el) el.innerHTML = `<span class="text-sm text-white/60">${text}</span>`;
			};

			const setErrorList = (id: string, text = "No data available") => {
				const el = document.getElementById(id);
				if (el) el.innerHTML = `<div class="text-sm text-white/60">${text}</div>`;
			};

			setErrorText("waka-total");
			setErrorText("waka-daily");
			setErrorText("waka-today");
			setErrorText("waka-range", "Stats unavailable");
			setErrorText("waka-today-date", "Stats unavailable");
			setErrorList("waka-os");
			setErrorList("waka-lang");
			setErrorList("waka-editor");
		}
	}

	initWakaTime();
</script>
