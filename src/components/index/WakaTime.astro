---
---

<section id="stats" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex items-center gap-3">
		<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
			<i class="ph-light ph-brackets-curly text-2xl"></i>
		</div>
		<h2 class="text-2xl font-bold text-white">Coding Stats</h2>
		<span class="ml-auto text-xs text-white/40">via WakaTime</span>
	</div>

	<div id="waka-root" class="space-y-4">
		<div class="grid gap-4 sm:grid-cols-3">
			<div class="skeleton h-28"></div><div class="skeleton h-28"></div><div class="skeleton h-28"></div>
		</div>
		<div class="skeleton h-72"></div>
		<div class="grid gap-4 lg:grid-cols-2">
			<div class="skeleton h-56"></div><div class="skeleton h-56"></div>
		</div>
	</div>
</section>

<script>
	import { onSnapshot, pick, refresh } from "../../lib/api";
	import { html, toHtml, fmt, duration, shortDay, longDate, percent } from "../../lib/format";
	import { observeReveals } from "../../lib/fx";

	const root = document.getElementById("waka-root")!;

	const PALETTE = ["#34d399", "#60a5fa", "#f472b6", "#fbbf24", "#a78bfa", "#fb923c"];

	const stat = (icon: string, label: string, valueHtml: ReturnType<typeof html>, hint: string, index: number) => html`
		<div class="card-shell card-pad lift" data-reveal style="--i:${index}">
			<div class="relative z-10 flex items-center gap-2 text-white/50">
				<i class="ph-light ${icon} text-lg"></i>
				<span class="text-[11px] uppercase tracking-[0.14em]">${label}</span>
			</div>
			<p class="relative z-10 mt-2 text-2xl font-bold text-white sm:text-3xl">${valueHtml}</p>
			<p class="relative z-10 mt-0.5 text-xs text-white/40">${hint}</p>
		</div>
	`;

	const ranked = (title: string, items: { name: string; seconds: number }[], offset: number) => {
		const max = items[0]?.seconds || 1;
		const total = items.reduce((sum, item) => sum + item.seconds, 0) || 1;
		return html`
			<div>
				<h4 class="relative z-10 mb-3 text-[11px] uppercase tracking-[0.14em] text-white/45">${title}</h4>
				<ul class="relative z-10 space-y-3">
					${items.map(
						(item, i) => html`
							<li data-tip="${item.name}: ${duration(item.seconds)} (${Math.round(percent(item.seconds, total))}%)">
								<div class="flex items-baseline justify-between text-xs">
									<span class="text-white/80">${item.name}</span>
									<span class="text-white/45">${duration(item.seconds)}</span>
								</div>
								<div class="mt-1.5 h-1 overflow-hidden rounded-full bg-white/10">
									<div class="bar-fill h-full rounded-full" style="--v:${item.seconds / max};--d:${i};background:${PALETTE[(i + offset) % PALETTE.length]}"></div>
								</div>
							</li>
						`,
					)}
				</ul>
			</div>
		`;
	};

	const view = (w: any) => {
		const daily: { date: string; seconds: number }[] = w.daily ?? [];
		const max = Math.max(...daily.map((d) => d.seconds), 1);
		const avg = daily.length ? w.weekSeconds / daily.length : 0;
		const best = daily.reduce((a, b) => (b.seconds > a.seconds ? b : a), daily[0] ?? { date: "", seconds: 0 });
		const totalHours = Math.floor(w.totalSeconds / 3600);

		return html`
			<div class="grid gap-4 sm:grid-cols-3">
				${stat("ph-infinity", "All time", html`<span data-count="${totalHours}">0</span><span class="text-lg font-medium text-white/50"> hrs</span>`, w.total, 0)}
				${stat("ph-calendar-blank", "Last 7 days", html`<span data-count="${(w.weekSeconds / 3600).toFixed(1)}" data-decimals="1">0</span><span class="text-lg font-medium text-white/50"> hrs</span>`, `${duration(w.weekSeconds)} in total`, 1)}
				${stat("ph-timer", "Daily average", html`${duration(avg)}`, best.seconds ? `best day ${shortDay(best.date)} · ${duration(best.seconds)}` : "last 7 days", 2)}
			</div>
			<div class="card-shell-lg card-pad" data-reveal>
				<h3 class="relative z-10 text-sm font-semibold tracking-wide text-white/90">This week</h3>
				<div class="relative z-10 mt-6 flex h-64 items-end justify-around sm:h-72">
					${daily.map(
						(day, i) => html`
							<div class="group flex h-full flex-1 flex-col items-center justify-end gap-2" data-tip="${longDate(day.date)}\n${duration(day.seconds)} coded">
								<div class="col-fill w-5 rounded-full sm:w-6 ${day.date === best.date ? "bg-emerald-300" : "bg-white/25 group-hover:bg-white/45"} transition-colors" style="--v:${Math.max(0.03, day.seconds / max)};--d:${i};height:calc(100% - 22px)"></div>
								<span class="text-[10px] ${day.date === best.date ? "text-white" : "text-white/45"}">${shortDay(day.date)}</span>
							</div>
						`,
					)}
				</div>
			</div>
			<div class="grid gap-4 lg:grid-cols-2">
				<div class="card-shell-lg card-pad" data-reveal>
					${ranked("Languages", w.languages ?? [], 0)}
				</div>
				<div class="card-shell-lg card-pad" data-reveal style="--i:1">
					${ranked("Editors", w.editors ?? [], 3)}
				</div>
			</div>
		`;
	};

	let last = "";

	onSnapshot((snapshot, meta) => {
		const w = pick(snapshot, "wakatime");

		if (!w) {
			if (last === "error" || (!snapshot && !meta.error)) return;
			last = "error";
			root.innerHTML = `<div class="card-empty"><p>Couldn't load coding stats right now.</p><button id="waka-retry" class="btn-outline mt-4">Try again</button></div>`;
			root.querySelector("#waka-retry")?.addEventListener("click", () => void refresh(true));
			return;
		}

		const key = JSON.stringify(w);
		if (key === last) return;
		last = key;

		root.innerHTML = toHtml(view(w));
		observeReveals(root);
	});
</script>
