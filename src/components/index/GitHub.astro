---
const tileSkeletons = Array(6).fill(0);
---

<section id="github" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex flex-wrap items-center gap-3">
		<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
			<i class="ph-light ph-github-logo text-2xl"></i>
		</div>
		<h2 class="text-2xl font-bold text-white">GitHub Activity</h2>
		<span id="gh-status" class="hidden max-w-full truncate rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/60"></span>
		<span id="gh-sync" class="ml-auto text-xs text-white/40"></span>
	</div>

	<div id="gh-root" class="space-y-4">
		<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
			{tileSkeletons.map(() => <div class="skeleton h-24" />)}
		</div>
		<div class="skeleton h-56" />
		<div class="grid gap-4 lg:grid-cols-3">
			<div class="skeleton h-56" /><div class="skeleton h-56" /><div class="skeleton h-56" />
		</div>
	</div>
</section>

<script>
	import { onSnapshot, pick, refresh, snapshotTime } from "../../lib/api";
	import { html, toHtml, fmt, timeAgo, longDate, esc, raw } from "../../lib/format";
	import { observeReveals } from "../../lib/fx";

	const root = document.getElementById("gh-root")!;
	const syncEl = document.getElementById("gh-sync")!;
	const statusEl = document.getElementById("gh-status")!;

	const WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
	const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

	interface Day {
		date: string;
		count: number;
		weekday: number;
	}

	const tile = (icon: string, label: string, value: number, index: number, hint = "") => html`
		<div class="card-shell card-pad lift" data-reveal style="--i:${index}">
			<div class="relative z-10 flex items-center gap-2 text-white/50">
				<i class="ph-light ${icon} text-lg"></i>
				<span class="text-[11px] uppercase tracking-[0.14em]">${label}</span>
			</div>
			<p class="relative z-10 mt-2 text-2xl font-bold text-white sm:text-3xl" data-count="${value}">0</p>
			${hint ? html`<p class="relative z-10 mt-0.5 text-xs text-white/40">${hint}</p>` : ""}
		</div>
	`;

	const levelFor = (days: Day[]) => {
		const active = days.map((day) => day.count).filter((count) => count > 0).sort((a, b) => a - b);
		const at = (p: number) => active[Math.min(active.length - 1, Math.floor(active.length * p))] ?? 1;
		const [q1, q2, q3] = [at(0.25), at(0.5), at(0.75)];
		return (count: number) => (count === 0 ? 0 : count <= q1 ? 1 : count <= q2 ? 2 : count <= q3 ? 3 : 4);
	};

	const heatmap = (g: any) => {
		const days: Day[] = g.contributionDays ?? g.calendar?.contributionDays ?? [];
		if (days.length === 0) return html`<div class="card-empty">No contribution data yet.</div>`;

		const pad = days[0].weekday;
		const cols = Math.ceil((days.length + pad) / 7);
		const level = levelFor(days);

		const monthAt = (col: number) => Number(days[Math.max(0, col * 7 - pad)].date.slice(5, 7)) - 1;
		const labels: { col: number; name: string }[] = [];
		let previous = -1;
		let lastCol = -10;
		for (let col = 0; col < cols; col++) {
			const month = monthAt(col);
			if (month !== previous && col - lastCol >= 3 && (col > 0 || monthAt(Math.min(3, cols - 1)) === month)) {
				labels.push({ col, name: MONTHS[month] });
				lastCol = col;
			}
			previous = month;
		}

		const cells = [
			...Array.from({ length: pad }, () => html`<span></span>`),
			...days.map((day, index) => {
				const col = Math.floor((index + pad) / 7);
				const tip = `${day.count === 0 ? "No" : fmt(day.count)} contribution${day.count === 1 ? "" : "s"}\n${longDate(day.date)}`;
				return html`<span class="hm-cell hm-${level(day.count)}" style="--w:${col}" data-tip="${tip}"></span>`;
			}),
		];

		const best = g.bestDay;
		return html`
			<div class="card-shell-lg card-pad" data-reveal>
				<div class="relative z-10 mb-4 flex flex-wrap items-end justify-between gap-2">
					<div>
						<h3 class="text-sm font-semibold tracking-wide text-white/90">Contribution activity</h3>
						<p class="text-xs text-white/50"><span class="font-semibold text-white" data-count="${g.contributions}">0</span> contributions in the last year</p>
					</div>
					${best ? html`<p class="text-xs text-white/50">Best day <span class="text-white">${fmt(best.count)}</span> on ${longDate(best.date)}</p>` : ""}
				</div>
				<div class="relative z-10 overflow-x-auto pb-2" id="hm-scroll">
					<div class="min-w-[680px]" role="img" aria-label="Contribution heatmap for the last year">
						<div class="mb-1 grid text-[10px] text-white/40" style="grid-template-columns:repeat(${cols},minmax(0,1fr));gap:3px">
							${labels.map((label) => html`<span class="whitespace-nowrap" style="grid-column:${label.col + 1}">${label.name}</span>`)}
						</div>
						<div class="hm-grid" style="grid-auto-columns:minmax(0,1fr)">${cells}</div>
					</div>
				</div>
				<div class="relative z-10 mt-3 flex items-center justify-end gap-1.5 text-[10px] text-white/40">
					Less
					${[0, 1, 2, 3, 4].map((n) => html`<span class="h-2.5 w-2.5 rounded-[3px] hm-${n}" style="opacity:1;transform:none"></span>`)}
					More
				</div>
			</div>
		`;
	};

	const languages = (g: any) => {
		const list = [...(g.languages ?? [])].sort((a: any, b: any) => b.repos - a.repos).slice(0, 8);
		const total = list.reduce((sum: number, item: any) => sum + item.repos, 0) || 1;
		const max = list[0]?.repos || 1;
		return html`
			<div class="card-shell-lg card-pad" data-reveal style="--i:0">
				<h3 class="relative z-10 text-sm font-semibold tracking-wide text-white/90">Languages</h3>
				<div class="relative z-10 mt-4 overflow-hidden rounded-full">
					<div class="bar-fill flex h-3 w-full">
						${list.map((item: any) => html`<span style="flex:${item.repos};background:${item.color ?? "#888"}" data-tip="${item.name}: ${item.repos} repos (${Math.round((item.repos / total) * 100)}%)"></span>`)}
					</div>
				</div>
				<ul class="relative z-10 mt-4 space-y-2.5">
					${list.map(
						(item: any, i: number) => html`
							<li>
								<div class="flex items-center justify-between text-xs">
									<span class="flex items-center gap-2 text-white/80"><span class="h-2 w-2 rounded-full" style="background:${item.color ?? "#888"}"></span>${item.name}</span>
									<span class="text-white/45">${item.repos} repos${item.stars ? html` · ${fmt(item.stars)} ★` : ""}</span>
								</div>
								<div class="mt-1 h-1 overflow-hidden rounded-full bg-white/10">
									<div class="bar-fill h-full rounded-full" style="--v:${item.repos / max};--d:${i};background:${item.color ?? "#888"}"></div>
								</div>
							</li>
						`,
					)}
				</ul>
			</div>
		`;
	};

	const highlights = (g: any) => {
		const rows: [string, string, number | string][] = [
			["ph-git-commit", "Commits", g.commits],
			["ph-git-pull-request", "Pull requests", g.pullRequests],
			["ph-bug", "Issues opened", g.issues],
			["ph-calendar-check", "Active days", g.activeDays],
			["ph-chart-line-up", "Avg per day", Number(g.averagePerDay).toFixed(1)],
			["ph-buildings", "Contributed to", `${g.contributedTo} repos`],
		];
		return html`
			<div class="card-shell-lg card-pad" data-reveal style="--i:1">
				<h3 class="relative z-10 text-sm font-semibold tracking-wide text-white/90">Highlights</h3>
				<dl class="relative z-10 mt-3 divide-y divide-white/5">
					${rows.map(
						([icon, label, value]) => html`
							<div class="flex items-center justify-between py-2 text-sm">
								<dt class="flex items-center gap-2 text-white/60"><i class="ph-light ${icon}"></i>${label}</dt>
								<dd class="font-semibold text-white">${typeof value === "number" ? fmt(value) : value}</dd>
							</div>
						`,
					)}
				</dl>
			</div>
		`;
	};

	const view = (g: any) => html`
		<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
			${tile("ph-git-commit", "Contributions", g.contributions, 0, "last 12 months")}
			${tile("ph-fire", "Streak", g.currentStreak, 1, "days, current")}
			${tile("ph-trophy", "Best streak", g.longestStreak, 2, "days")}
			${tile("ph-star", "Stars", g.stars, 3, "across repos")}
			${tile("ph-folder-simple", "Repos", g.repos, 4, `${g.private ?? 0} private`)}
			${tile("ph-users", "Followers", g.followers, 5, `${fmt(g.following)} following`)}
		</div>
		${heatmap(g)}
		<div class="grid gap-4 lg:grid-cols-2">${languages(g)}${highlights(g)}</div>
	`;

	let last = "";

	onSnapshot((snapshot, meta) => {
		const g = pick(snapshot, "github");
		const time = snapshotTime(snapshot);
		syncEl.textContent = time ? `${meta.error ? "Offline · " : ""}Updated ${timeAgo(time)}` : "";

		if (!g) {
			if (last === "error" || !snapshot && !meta.error) return;
			last = "error";
			root.innerHTML = `<div class="card-empty"><i class="ph ph-warning text-4xl text-white/40 mb-4"></i><p>Couldn't load GitHub activity right now.</p><button id="gh-retry" class="btn-outline mt-4">Try again</button></div>`;
			root.querySelector("#gh-retry")?.addEventListener("click", () => void refresh(true));
			return;
		}

		const message = g.status?.message;
		statusEl.textContent = message ? String(message) : "";
		statusEl.classList.toggle("hidden", !message);

		const key = JSON.stringify(g);
		if (key === last) return;
		last = key;

		root.innerHTML = toHtml(view(g));
		observeReveals(root);
		const scroller = document.getElementById("hm-scroll");
		if (scroller) scroller.scrollLeft = scroller.scrollWidth;
	});
</script>
