---
const skills = [
	{
		title: "Languages",
		icon: "ph-code",
		items: ["python", "html", "css", "javascript", "bash", "c", "java"],
		tooltips: ["Python", "HTML", "CSS", "JavaScript", "Bash", "C", "Java"],
		gridClass: "md:col-span-2",
	},
	{
		title: "Design",
		icon: "ph-paint-brush",
		items: ["illustrator", "xd", "figma"],
		tooltips: ["Adobe Illustrator", "Adobe XD", "Figma"],
		gridClass: "md:col-span-1",
	},
	{
		title: "Database",
		icon: "ph-database",
		items: ["sqlite", "mongo", "mysql", "postgres"],
		tooltips: ["SQLite", "MongoDB", "MySQL", "PostgreSQL"],
		gridClass: "md:col-span-1",
	},
	{
		title: "Technologies",
		icon: "ph-stack",
		items: [
			"django",
			"flask",
			"tensorflow",
			"nodejs",
			"opencv",
			"tailwind",
			"vue",
			"pytorch",
			"astro",
			"sklearn",
		],
		tooltips: [
			"Django",
			"Flask",
			"TensorFlow",
			"Node.js",
			"OpenCV",
			"Tailwind CSS",
			"Vue.js",
			"PyTorch",
			"Astro",
			"Scikit Learn",
		],
		gridClass: "md:col-span-2",
	},
	{
		title: "Tools",
		icon: "ph-wrench",
		items: [
			"linux",
			"vscode",
			"sublime",
			"replit",
			"notion",
			"github",
			"discord",
		],
		tooltips: [
			"Linux",
			"VS Code",
			"Sublime Text",
			"Replit",
			"Notion",
			"GitHub",
			"Discord",
		],
		gridClass: "md:col-span-2",
	},
];
---

<section id="skills" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex items-center gap-3">
		<div
			class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white"
		>
			<i class="ph ph-wrench text-2xl"></i>
		</div>
		<h2 class="text-2xl font-bold text-white">My Skills</h2>
	</div>

	<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
		{
			skills.map((category) => (
				<article
					class={`card-shell flex flex-col justify-between ${category.gridClass}`}
				>
					<header class="card-header">
						<h3 class="text-sm font-semibold text-white/90 tracking-wide">
							{category.title}
						</h3>
					</header>

					<section class="flex-1 p-4">
						<div class="flex flex-wrap gap-2">
							{category.items.map((skill) => (
								<div class="group/icon relative flex items-center justify-center">
									<img
										src={`https://skillicons.dev/icons?i=${skill}&theme=dark`}
										alt={skill}
										class="h-10 w-10 object-contain rounded-xl opacity-75 group-hover/icon:opacity-100 transition-opacity border border-white/5 hover:border-white/20"
										loading="lazy"
									/>

									<span class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-black/90 px-2 py-0.5 text-[10px] text-white opacity-0 transition-opacity group-hover/icon:opacity-100 border border-white/10 ">
										{
											category.tooltips[
												category.items.indexOf(skill)
											]
										}
									</span>
								</div>
							))}
						</div>
					</section>
				</article>
			))
		}
	</div>
</section>
