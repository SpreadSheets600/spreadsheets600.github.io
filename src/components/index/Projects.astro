---
import ProjectCard from "../ProjectCard.astro";
import featuredConfig from "../../data/featured-projects.json";
import { fetchPublicRepos, type GitHubRepo } from "../../lib/repositories.ts";

type FeaturedProject = Omit<GitHubRepo, "html_url"> & {
	html_url?: string | null;
	image?: string | null;
};

interface FeaturedProjectConfig {
	repo?: string;
	enabled?: boolean;
	order?: number;
	image?: string;
	title?: string;
	description?: string;
	homepage?: string;
	github?: string;
	topics?: string[];
	language?: string;
	stargazers_count?: number;
	forks_count?: number;
}

const GITHUB_USERNAME = "SpreadSheets600";

let projects: FeaturedProject[] = [];
let error = false;

try {
	const featuredProjects: FeaturedProjectConfig[] = (featuredConfig?.projects || []).filter((project) => project && project.enabled !== false).sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const githubToken = Astro.locals.runtime?.env?.GITHUB_PAT || Astro.locals.runtime?.env?.GITHUB_TOKEN || import.meta.env.GITHUB_PAT || import.meta.env.GITHUB_TOKEN;
	const { repos: baseRepos, ok } = await fetchPublicRepos(GITHUB_USERNAME, githubToken);
	error = !ok;
	const repoMap = new Map(baseRepos.map((repo) => [repo.name.toLowerCase(), repo]));

	if (featuredProjects.length > 0) {
		projects = featuredProjects
			.map((featured) => {
				const repoName = featured.repo?.trim() || "";
				const repo = repoName ? repoMap.get(repoName.toLowerCase()) : null;
				const title = featured.title?.trim() || repo?.name || repoName;

				if (!title) return null;

				return {
					name: title,
					description: featured.description?.trim() || repo?.description || null,
					homepage: featured.homepage?.trim() || repo?.homepage || null,
					html_url: featured.github?.trim() || repo?.html_url || null,
					language: featured.language?.trim() || repo?.language || null,
					topics: Array.isArray(featured.topics) ? featured.topics : (repo?.topics ?? []),
					stargazers_count: featured.stargazers_count ?? repo?.stargazers_count ?? 0,
					forks_count: featured.forks_count ?? repo?.forks_count ?? 0,
					updated_at: repo?.updated_at || "",
					image: featured.image?.trim() || null,
				} satisfies FeaturedProject;
			})
			.filter(Boolean) as FeaturedProject[];
	} else if (baseRepos.length > 0) {
		projects = baseRepos.slice(0, 6).map((repo) => ({ ...repo }));
	}
} catch (e) {
	error = true;
}
---

<section id="projects" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex items-center justify-between">
		<div class="flex items-center gap-3">
			<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
				<i class="ph-light ph-code text-2xl"></i>
			</div>
			<h2 class="text-2xl font-bold text-white">Featured Projects</h2>
		</div>
	</div>

	{
		error ? <div class="card-empty">Unable to load projects right now.</div>
		: projects.length === 0 ? <div class="card-empty">No Projects Found</div>
		: <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
	}

	<div class="mt-6 flex justify-center">
		<a href="/projects" class="btn-outline">
			View All
			<i class="ph ph-arrow-right"></i>
		</a>
	</div>
</section>
