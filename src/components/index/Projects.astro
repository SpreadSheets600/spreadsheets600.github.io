---
import ProjectCard from "../ProjectCard.astro";
import featuredConfig from "../../data/featured-projects.json";
import { fetchPublicRepos, type GitHubRepo } from "../../lib/repositories.ts";

type FeaturedGitHubRepo = GitHubRepo & { image?: string | null };

interface FeaturedProjectConfig {
	repo: string;
	enabled?: boolean;
	order?: number;
	image?: string;
	title?: string;
	description?: string;
	homepage?: string;
}

const GITHUB_USERNAME = "SpreadSheets600";

let projects: FeaturedGitHubRepo[] = [];
let error = false;

try {
	const featuredProjects: FeaturedProjectConfig[] = (featuredConfig?.projects || []).filter((project) => project && project.repo && project.enabled !== false).sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

	const { repos: baseRepos, ok } = await fetchPublicRepos(GITHUB_USERNAME);
	error = !ok;

	if (baseRepos.length > 0) {
		const repoMap = new Map(baseRepos.map((repo) => [repo.name.toLowerCase(), repo]));

		if (featuredProjects.length > 0) {
			projects = featuredProjects
				.map((featured) => {
					const repo = repoMap.get(featured.repo.toLowerCase());
					if (!repo) return null;

					return {
						...repo,
						name: featured.title?.trim() || repo.name,
						description: featured.description?.trim() || repo.description,
						homepage: featured.homepage?.trim() || repo.homepage,
						image: featured.image?.trim() || null,
					} satisfies FeaturedGitHubRepo;
				})
				.filter(Boolean) as FeaturedGitHubRepo[];
		} else {
			projects = baseRepos.slice(0, 6).map((repo) => ({ ...repo }));
		}
	}
} catch (e) {
	error = true;
}
---

<section id="projects" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex items-center justify-between">
		<div class="flex items-center gap-3">
			<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
				<i class="ph-light ph-code text-2xl"></i>
			</div>
			<h2 class="text-2xl font-bold text-white">Featured Projects</h2>
		</div>
	</div>

	{
		error ? <div class="card-empty">Unable to load projects right now.</div>
		: projects.length === 0 ? <div class="card-empty">No Projects Found</div>
		: <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
	}

	<div class="mt-6 flex justify-center">
		<a href="/projects" class="btn-outline">
			View All
			<i class="ph ph-arrow-right"></i>
		</a>
	</div>
</section>
