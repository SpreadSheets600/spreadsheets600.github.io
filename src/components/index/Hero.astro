---
import LivePills from "../LivePills.astro";
---

<header class="relative py-12 sm:py-16 lg:py-20">
	<div
		class="grid items-center gap-8 lg:gap-10 lg:grid-cols-2 justify-center"
	>
		<div class="flex flex-col items-center text-center order-2 lg:order-1">
			<h1
				class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white"
			>
				<span
					class="bg-gradient-to-b from-white to-white/70 bg-clip-text text-transparent"
				>
					「 SOHAM MAITY 」
				</span>
			</h1>
			<p class="mt-4 max-w-xl text-white/80 text-sm sm:text-base">
				Computer Science Major • Tech Enthusiast • Anime Lover • Blogger
			</p>
			<LivePills class="mt-5 justify-center" />
			<div class="mt-6 flex flex-wrap gap-3 justify-center">
				<a href="/projects" class="btn-outline"
					>View Projects <i class="ph ph-arrow-right"></i></a
				>
				<a href="#contact" class="btn-outline"
					>Contact Me <i class="ph ph-address-book"></i></a
				>
				<a
					href="https://blogs.spreadsheets600.buzz"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-outline">My Blog <i class="ph ph-article"></i></a
				>
				<a
					href="/CV.pdf"
					download="Soham-Maity-CV.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-outline"
					>Download CV<i class="ph ph-download"></i></a
				>
			</div>
		</div>
		<div class="flex justify-center lg:justify-end order-1 lg:order-2">
			<div class="relative">
				<div
					class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-white/20 via-white/10 to-transparent blur-xl"
				>
				</div>
				<img
					src="https://avatars.githubusercontent.com/u/115402296?v=4"
					alt="Soham profile picture"
					class="relative w-48 h-48 sm:w-64 sm:h-64 lg:w-72 lg:h-72 xl:w-80 xl:h-80 rounded-2xl object-cover ring-1 ring-white/20 shadow-[0_0_40px_rgba(255,255,255,0.15)]"
				/>
			</div>
		</div>
	</div>
</header>
