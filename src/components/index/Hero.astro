---
import { API_BASE } from "../../lib/api";

const fallbacks = ["/backgrounds/bg-1.webp", "/backgrounds/bg-2.webp", "/backgrounds/bg-3.webp", "/backgrounds/bg-4.webp", "/backgrounds/bg-5.webp"];
let wallpaper = fallbacks[Math.floor(Math.random() * fallbacks.length)];
try {
	const res = await fetch(`${API_BASE}/header?format=json`, { signal: AbortSignal.timeout(8000) });
	if (res.ok) wallpaper = ((await res.json()) as { url?: string }).url || wallpaper;
} catch {}
---

<header class="relative py-12 sm:py-16 lg:py-20">
	<div
		class="grid items-center gap-8 lg:gap-10 lg:grid-cols-2 justify-center"
	>
		<div class="flex flex-col items-center text-center order-2 lg:order-1">
			<h1
				class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white"
			>
				<span
					class="bg-gradient-to-b from-white to-white/70 bg-clip-text text-transparent"
				>
					「 SOHAM MAITY 」
				</span>
			</h1>
			<p class="mt-4 max-w-xl text-white/80 text-sm sm:text-base">
				Computer Science Major • Tech Enthusiast • Anime Lover • Blogger
			</p>
			<div class="mt-6 flex flex-wrap gap-3 justify-center">
				<a href="/projects" class="btn-outline"
					>View Projects <i class="ph ph-arrow-right"></i></a
				>
				<a href="#contact" class="btn-outline"
					>Contact Me <i class="ph ph-address-book"></i></a
				>
				<a
					href="https://blogs.spreadsheets600.buzz"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-outline">My Blog <i class="ph ph-article"></i></a
				>
				<a
					href="/CV.pdf"
					download="Soham-Maity-CV.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-outline"
					>Download CV<i class="ph ph-download"></i></a
				>
			</div>
		</div>
		<div class="flex justify-center lg:justify-end order-1 lg:order-2">
			<div class="w-full max-w-md overflow-hidden rounded-3xl border border-white/15 bg-black/50 shadow-[0_0_40px_rgba(255,255,255,0.1)] backdrop-blur-sm">
				<div class="h-32 sm:h-40 w-full bg-cover bg-center" style={`background-image:url('${wallpaper}')`}></div>
				<div class="px-5 pb-6 sm:px-6">
					<img
						src="https://avatars.githubusercontent.com/u/115402296?v=4&s=320" width="128" height="128" fetchpriority="high" decoding="async"
						alt="Soham profile picture"
						class="-mt-12 sm:-mt-16 h-24 w-24 sm:h-32 sm:w-32 rounded-full object-cover ring-4 ring-black/70"
					/>
					<h2 class="mt-3 text-2xl sm:text-3xl font-bold text-white">SpreadSheets600</h2>
					<p class="mt-1 text-sm text-white/70">Building things, breaking things, watching anime.</p>
				</div>
			</div>
		</div>
	</div>
</header>
