---

---

<section id="github" class="scroll-mt-24 mt-8 sm:mt-12">
	<div class="mb-8 flex items-center gap-3">
		<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
			<i class="ph-light ph-github-logo text-2xl"></i>
		</div>
		<h2 class="text-2xl font-bold text-white">GitHub Stats</h2>
	</div>

	<div class="grid gap-4 sm:gap-6">
		<div class="grid gap-4 sm:gap-6 lg:grid-cols-2">
			<div class="github-card group relative overflow-hidden rounded-3xl border border-white/10 bg-black/40 p-4 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:shadow-2xl hover:shadow-primary/5">
				<div class="skeleton absolute inset-0 bg-white/5 animate-pulse z-0"></div>
				<img class="relative z-10 w-full rounded-xl opacity-0 transition-opacity duration-500" src="https://github-readme-stats.vercel.app/api?username=spreadsheets600&count_private=true&show_icons=true&include_all_commits=true&line_height=21&hide_border=true&theme=dark&title_color=ffffff&text_color=ffffff&icon_color=ffffff&bg_color=00000000" alt="GitHub stats" loading="lazy" onload="this.classList.remove('opacity-0'); this.previousElementSibling.style.display='none';" />
			</div>

			<div class="github-card group relative overflow-hidden rounded-3xl border border-white/10 bg-black/40 p-4 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:shadow-2xl hover:shadow-primary/5">
				<div class="skeleton absolute inset-0 bg-white/5 animate-pulse z-0"></div>
				<img
					class="relative z-10 w-full rounded-xl opacity-0 transition-opacity duration-500"
					src="https://github-readme-streak-stats.herokuapp.com/?user=spreadsheets600&theme=dark&card_height=180&hide_border=true&background=151515&stroke=FFFFFF&ring=FFFFFF&fire=FFFFFF&currStreakNum=FFFFFF&sideNums=FFFFFF&currStreakLabel=FFFFFF&sideLabels=FFFFFF&dates=FFFFFF"
					alt="GitHub streak"
					loading="lazy"
					onload="this.classList.remove('opacity-0'); this.previousElementSibling.style.display='none';"
				/>
			</div>
		</div>

		<div class="github-card group relative overflow-hidden rounded-3xl border border-white/10 bg-black/40 p-4 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:shadow-2xl hover:shadow-primary/5">
			<div class="skeleton absolute inset-0 bg-white/5 animate-pulse z-0"></div>
			<img class="relative z-10 w-full rounded-xl opacity-0 transition-opacity duration-500" src="https://github-readme-activity-graph.vercel.app/graph?username=SpreadSheets600&theme=react-dark&hide_border=true&bg_color=151515&color=FFFFFF&line=FFFFFF&point=FFFFFF" alt="GitHub activity graph" loading="lazy" onload="this.classList.remove('opacity-0'); this.previousElementSibling.style.display='none';" />
		</div>

		<div class="github-card group relative overflow-hidden rounded-3xl border border-white/10 bg-black/40 p-4 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:shadow-2xl hover:shadow-primary/5">
			<div class="skeleton absolute inset-0 bg-white/5 animate-pulse z-0"></div>
			<img class="relative z-10 w-full rounded-xl opacity-0 transition-opacity duration-500" src="https://holopin.me/spreadsheets600" alt="Holopin badges" loading="lazy" onload="this.classList.remove('opacity-0'); this.previousElementSibling.style.display='none';" />
		</div>
	</div>
</section>
