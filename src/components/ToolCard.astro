---
interface Props {
  tool: {
    title: string;
    description?: string;
    icon: string;
    text?: string;
    prompt?: string;
    links?: {
      label: string;
      url: string;
      primary: boolean;
    }[];
    note?: string;
  };
  accent: string;
  accentSoft: string;
  accentFaint: string;
}

const { tool, accent, accentSoft, accentFaint } = Astro.props;
const links = (tool.links ?? []).filter((link) => link.url && link.url !== "#");
const primaryLink = links.find((link) => link.primary) ?? links[0];
---

<article
  class={`tool-card group flex h-full flex-col ${primaryLink ? "tool-card-clickable" : ""}`}
  style={`--accent:${accent}; --accent-soft:${accentSoft}; --accent-faint:${accentFaint};`}
  data-link={primaryLink?.url}
  data-link-target={primaryLink ? "_blank" : undefined}
  role={primaryLink ? "link" : undefined}
  tabindex={primaryLink ? "0" : undefined}
>
  <div class="flex items-center gap-3 mb-4">
    <div class="tool-icon">
      <i class={`ph ${tool.icon} text-xl sm:text-2xl`}></i>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-base sm:text-lg font-semibold truncate">{tool.title}</h3>
      {tool.note && <p class="text-[11px] uppercase tracking-[0.2em] text-white/40 mt-1">{tool.note}</p>}
    </div>
  </div>

  {tool.description && <p class="text-xs sm:text-sm text-white/75 mb-4">{tool.description}</p>}

  {tool.text && (
    <p class="text-xs sm:text-sm text-white/70 mb-4 whitespace-pre-line">{tool.text}</p>
  )}

  {tool.prompt && (
    <div class="prompt-shell">
      <p class="text-[11px] uppercase tracking-[0.2em] text-white/40">Prompt</p>
      <pre class="prompt-box">{tool.prompt}</pre>
      <button class="btn-copy" type="button" data-copy-prompt={tool.prompt}>
        Copy Prompt
      </button>
    </div>
  )}

  {primaryLink && <i class="ph ph-arrow-up-right tool-arrow" aria-hidden="true" />}
</article>

{primaryLink && (
  <script>
    const cards = Array.from(document.querySelectorAll(".tool-card-clickable"));

    cards.forEach((card) => {
      const url = card.getAttribute("data-link");
      if (!url) return;

      const open = () => window.open(url, "_blank", "noopener,noreferrer");

      card.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("button, a, [data-no-card-link]")) return;
        open();
      });

      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open();
        }
      });
    });
  </script>
)}

<style>
  .tool-card {
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.32));
    padding: 16px;
    backdrop-filter: blur(18px);
    transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
    position: relative;
    overflow: hidden;
  }

  .tool-card-clickable {
    cursor: pointer;
  }

  .tool-arrow {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.55);
    transition: color 150ms ease;
  }

  .tool-card:hover .tool-arrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .tool-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(140px 80px at 90% 0%, var(--accent-faint), transparent 70%);
    opacity: 0.7;
    pointer-events: none;
  }

  .tool-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 22px -26px rgba(255, 255, 255, 0.4);
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.35));
  }

  .tool-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: linear-gradient(140deg, var(--accent-faint), rgba(255, 255, 255, 0.02));
    border: 1px solid var(--accent-soft);
    color: var(--accent);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.02) inset;
  }

  @media (min-width: 640px) {
    .tool-card {
      padding: 18px 20px;
    }
  }

  .prompt-shell {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.35);
    padding: 12px;
    margin-bottom: 16px;
  }

  .prompt-box {
    margin-top: 8px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .btn-copy {
    margin-top: 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    transition: transform 150ms ease, background 150ms ease, border-color 150ms ease;
  }

  .btn-copy:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
  }
</style>
