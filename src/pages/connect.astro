---
import Layout from "../layouts/Layout.astro";

import LinksCard from "../components/connect/LinksCard.astro";
import SteamCard from "../components/connect/SteamCard.astro";
import AniListStats from "../components/connect/AniListStats.astro";
import DiscordStatusCard from "../components/connect/DiscordStatusCard.astro";
import SpotifyNowPlaying from "../components/connect/SpotifyNowPlaying.astro";
import LivePills from "../components/LivePills.astro";

// All live data comes from the profile API in the browser, so this page is fully static.
export const prerender = true;

const sections = [
	{ id: "social-links", label: "Links", icon: "ph-link" },
	{ id: "live-status", label: "Live", icon: "ph-wave-sine" },
	{ id: "games", label: "Games", icon: "ph-game-controller" },
	{ id: "anime", label: "Anime", icon: "ph-television" },
];
---

<Layout title="Connect | SpreadSheets600">
	<div class="py-8 sm:py-16 flex-1">
		<header class="mb-8 sm:mb-12" data-reveal>
			<div class="card-shell-lg p-6 sm:p-8">
				<div class="relative z-10 flex flex-col gap-6">
					<div class="max-w-2xl">
						<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
							<span class="bg-gradient-to-b from-white to-white/70 bg-clip-text text-transparent">Connections</span>
						</h1>
						<p class="mt-3 text-sm text-white/60 sm:text-base">Where I'm hanging out, what I'm playing, listening to and watching, straight from my live profile API.</p>
					</div>

					<LivePills />

					<nav class="flex flex-wrap gap-2" aria-label="Sections">
						{
							sections.map((section) => (
								<a href={`#${section.id}`} class="lift inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/70 hover:border-white/25 hover:text-white">
									<i class={`ph ${section.icon}`} />
									{section.label}
								</a>
							))
						}
					</nav>
				</div>
			</div>
		</header>

		<section id="social-links" class="scroll-mt-24 mb-12">
			<LinksCard />
		</section>

		<section id="live-status" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3" data-reveal>
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-wave-sine text-2xl"></i>
				</div>
				<h2 class="text-2xl font-bold text-white">Live Status</h2>
			</div>

			<div class="grid gap-6 lg:grid-cols-2">
				<DiscordStatusCard />
				<SpotifyNowPlaying />
			</div>
		</section>

		<section id="games" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3" data-reveal>
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-game-controller text-2xl"></i>
				</div>
				<h2 class="text-2xl font-bold text-white">Steam</h2>
			</div>

			<SteamCard />
		</section>

		<section id="anime" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3" data-reveal>
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-television text-2xl"></i>
				</div>
				<h2 class="text-2xl font-bold text-white">AniList</h2>
			</div>

			<AniListStats />
		</section>
	</div>
</Layout>
