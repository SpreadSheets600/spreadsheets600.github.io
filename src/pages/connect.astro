---
import Layout from "../layouts/Layout.astro";

import LinksCard from "../components/connect/LinksCard.astro";
import SteamCard from "../components/connect/SteamCard.astro";
import AniListStats from "../components/connect/AniListStats.astro";
import DiscordStatusCard from "../components/connect/DiscordStatusCard.astro";
import SpotifyNowPlaying from "../components/connect/SpotifyNowPlaying.astro";

const steamVanity = import.meta.env.STEAM_VANITY;
---

<Layout title="Connect | SpreadSheets600">
	<main class="py-8 sm:py-16 flex-1">
		<header class="mb-8 sm:mb-12">
			<div class="card-shell-lg p-6 sm:p-8">
				<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
					<div class="max-w-2xl">
						<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
							<span class="bg-gradient-to-b from-white to-white/70 bg-clip-text">Connections</span>
						</h1>
					</div>
				</div>
			</div>
		</header>

		<section id="social-links" class="scroll-mt-24 mb-12">
			<LinksCard />
		</section>

		<section id="live-status" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-wave-sine text-2xl"></i>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-white">Live Status</h2>
				</div>
			</div>

			<div class="grid gap-6 lg:grid-cols-2">
				<DiscordStatusCard userId="727012870683885578" />
				<SteamCard vanity={steamVanity} />
			</div>
		</section>

		<section id="music" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-music-notes text-2xl"></i>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-white">Now Playing</h2>
				</div>
			</div>

			<SpotifyNowPlaying />
		</section>

		<section id="anime" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-television text-2xl"></i>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-white">AniList</h2>
				</div>
			</div>

			<AniListStats />
		</section>
	</main>
</Layout>
