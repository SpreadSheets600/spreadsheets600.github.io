<style>
  .social-link {
    @apply flex items-center justify-between bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm hover:bg-white/10 hover:border-white/20 hover:scale-[1.02] transition-all duration-300;
  }

  .playlist-card {
    @apply bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm hover:bg-white/10 hover:border-white/20 hover:scale-105 transition-all duration-300 cursor-pointer;
  }

  .stat-card {
    @apply bg-white/5 border border-white/10 rounded-xl p-6 text-center backdrop-blur-sm hover:bg-white/10 hover:border-white/20 transition-all duration-300;
  }
</style>

<script>
  // Lanyard Discord Status
  async function fetchDiscordStatus() {
    const DISCORD_USER_ID = 'YOUR_DISCORD_USER_ID'; // Replace with actual Discord User ID

    try {
      const response = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_USER_ID}`);
      const data = await response.json();

      if (data.success && data.data) {
        const user = data.data.discord_user;
        const activities = data.data.activities;

        // Update avatar
        const avatarEl = document.getElementById('discord-avatar');
        if (avatarEl) {
          avatarEl.style.backgroundImage = `url(https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png)`;
          avatarEl.style.backgroundSize = 'cover';
        }

        // Update username
        const usernameEl = document.getElementById('discord-username');
        if (usernameEl) {
          usernameEl.textContent = user.username;
        }

        // Update status indicator
        const statusEl = document.getElementById('discord-status-indicator');
        if (statusEl) {
          const statusColors = {
            online: '#43b581',
            idle: '#faa61a',
            dnd: '#f04747',
            offline: '#747f8d'
          };
          statusEl.style.backgroundColor = statusColors[data.data.discord_status] || statusColors.offline;
        }

        // Update activity
        const activityEl = document.getElementById('discord-activity');
        if (activityEl && activities && activities.length > 0) {
          const activity = activities[0];
          activityEl.textContent = `${activity.name}`;
        } else if (activityEl) {
          activityEl.textContent = 'No current activity';
        }
      }
    } catch (error) {
      console.error('Failed to fetch Discord status:', error);
    }
  }

  // Fetch Discord status on page load
  fetchDiscordStatus();
  // Refresh every 30 seconds
  setInterval(fetchDiscordStatus, 30000);
</script>
