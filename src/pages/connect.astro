    <!-- AniList Stats -->
    <div class="max-w-6xl mx-auto mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center">Anime Stats</h2>
      <div id="anilist-stats" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="stat-card">
          <h3 class="text-4xl font-bold gradient-text mb-2">-</h3>
          <p class="text-muted-foreground">Total Anime</p>
        </div>
        <div class="stat-card">
          <h3 class="text-4xl font-bold gradient-text mb-2">-</h3>
          <p class="text-muted-foreground">Episodes Watched</p>
        </div>
        <div class="stat-card">
          <h3 class="text-4xl font-bold gradient-text mb-2">-</h3>
          <p class="text-muted-foreground">Days Watched</p>
        </div>
      </div>

      <div class="bg-card border border-border rounded-lg p-6">
        <h3 class="text-xl font-semibold mb-4">Currently Watching</h3>
        <div class="text-center text-muted-foreground">
          <p>Connect AniList to display your anime stats</p>
          <p class="text-sm mt-2">Add your AniList username to the configuration</p>
        </div>
