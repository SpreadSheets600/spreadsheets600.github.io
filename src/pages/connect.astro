---
import Layout from "../layouts/Layout.astro";

import LinksCard from "../components/connect/LinksCard.astro";
import SteamCard from "../components/connect/SteamCard.astro";
import AniListStats from "../components/connect/AniListStats.astro";
import DiscordStatusCard from "../components/connect/DiscordStatusCard.astro";
import SpotifyNowPlaying from "../components/connect/SpotifyNowPlaying.astro";

const steamVanity = import.meta.env.STEAM_VANITY;

const sectionCount = 4;
const integrationCount = 4;
const sectionCountLabel = sectionCount.toLocaleString();
const integrationCountLabel = integrationCount.toLocaleString();
---

<Layout title="Connect | SpreadSheets600">
	<main class="py-8 sm:py-16 flex-1">
		<header class="mb-8 sm:mb-12">
			<div class="card-shell-lg p-6 sm:p-8">
				<div class="flex flex-col gap-6">
					<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
						<div class="max-w-2xl">
							<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
								<span class="bg-gradient-to-b from-white to-white/70 bg-clip-text">Connections</span>
							</h1>
						</div>

						<div class="grid grid-cols-2 gap-2 w-full lg:w-auto">
							<div class="card-shell group relative overflow-hidden px-3 py-2.5">
								<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-sky-400/10 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
								<div class="relative flex items-center gap-2.5">
									<div class="flex h-9 w-9 items-center justify-center rounded-lg border border-sky-300/30 bg-sky-400/10 text-sky-200 shadow-[0_0_16px_rgba(56,189,248,0.2)]">
										<i class="ph ph-squares-four text-lg"></i>
									</div>
									<div class="leading-tight">
										<p class="text-[11px] uppercase tracking-[0.14em] text-white/50">Sections</p>
										<p class="mt-0.5 text-xl font-bold text-white">{sectionCountLabel}</p>
									</div>
								</div>
							</div>
							<div class="card-shell group relative overflow-hidden px-3 py-2.5">
								<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-emerald-300/10 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
								<div class="relative flex items-center gap-2.5">
									<div class="flex h-9 w-9 items-center justify-center rounded-lg border border-emerald-300/30 bg-emerald-300/10 text-emerald-200 shadow-[0_0_16px_rgba(52,211,153,0.2)]">
										<i class="ph ph-plugs-connected text-lg"></i>
									</div>
									<div class="leading-tight">
										<p class="text-[11px] uppercase tracking-[0.14em] text-white/50">Integrations</p>
										<p class="mt-0.5 text-xl font-bold text-white">{integrationCountLabel}</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>

		<section id="social-links" class="scroll-mt-24 mb-12">
			<LinksCard />
		</section>

		<section id="live-status" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-wave-sine text-2xl"></i>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-white">Live Status</h2>
				</div>
			</div>

			<div class="grid gap-6 lg:grid-cols-2">
				<DiscordStatusCard userId="727012870683885578" />
				<SteamCard vanity={steamVanity} />
			</div>
		</section>

		<section id="music" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-music-notes text-2xl"></i>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-white">Now Playing</h2>
				</div>
			</div>

			<SpotifyNowPlaying />
		</section>

		<section id="anime" class="scroll-mt-24 mb-12">
			<div class="mb-6 flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
					<i class="ph ph-television text-2xl"></i>
				</div>
				<div>
					<h2 class="text-2xl font-bold text-white">AniList</h2>
				</div>
			</div>

			<AniListStats />
		</section>
	</main>
</Layout>
