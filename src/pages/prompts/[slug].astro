---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  return prompts.map((prompt) => ({
    params: { slug: prompt.slug },
    props: { prompt },
  }));
}

const { prompt } = Astro.props;
const { Content } = await prompt.render();
---

<Layout title={prompt.data.title}>
  <article class="max-w-4xl mx-auto px-4 py-20">
    <div class="mb-8">
      <h1 class="text-5xl font-bold mb-4 gradient-text">{prompt.data.title}</h1>
      <p class="text-xl text-muted-foreground mb-4">{prompt.data.description}</p>
      <div class="flex items-center gap-4 text-sm text-muted-foreground mb-4">
        <span class="bg-secondary text-secondary-foreground px-3 py-1 rounded">
          {prompt.data.category}
        </span>
        <time datetime={prompt.data.date.toISOString()}>
          {prompt.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
      {prompt.data.tags && (
        <div class="flex flex-wrap gap-2">
          {prompt.data.tags.map((tag) => (
            <span class="text-xs bg-secondary text-secondary-foreground px-3 py-1 rounded">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="bg-card border border-border rounded-lg p-6 mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold">Prompt</h2>
        <button
          id="copy-button"
          class="bg-primary text-primary-foreground px-4 py-2 rounded hover:opacity-90 transition-opacity text-sm font-medium"
        >
          Copy
        </button>
      </div>
      <div id="prompt-content" class="prose prose-invert prose-lg max-w-none">
        <Content />
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border">
      <a href="/prompts" class="text-primary hover:underline">← Back to all prompts</a>
    </div>
  </article>
</Layout>

<style is:global>
  .prose {
    @apply text-foreground;
  }
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    @apply text-foreground font-bold;
  }
  .prose code {
    @apply bg-muted px-1 py-0.5 rounded text-sm;
  }
  .prose pre {
    @apply bg-muted p-4 rounded-lg overflow-x-auto;
  }
</style>

<script>
  const copyButton = document.getElementById('copy-button');
  const promptContent = document.getElementById('prompt-content');

  if (copyButton && promptContent) {
    copyButton.addEventListener('click', () => {
      const text = promptContent.innerText;
      navigator.clipboard.writeText(text).then(() => {
        copyButton.textContent = 'Copied!';
        setTimeout(() => {
          copyButton.textContent = 'Copy';
        }, 2000);
      });
    });
  }
</script>
