---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export const prerender = true;
const LIST_PAGE_SIZE = 10;

export async function getStaticPaths() {
	const pageSize = 10;
	const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
	const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));

	return Array.from({ length: totalPages }, (_, i) => ({
		params: { page: String(i + 1) },
	}));
}

const posts = (await getCollection("blog"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalCount = posts.length;
const totalPages = Math.max(1, Math.ceil(totalCount / LIST_PAGE_SIZE));
const pageNumber = Number(Astro.params.page ?? "1");

if (!Number.isFinite(pageNumber) || pageNumber < 1 || pageNumber > totalPages) {
	return Astro.redirect("/blog/");
}

const start = (pageNumber - 1) * LIST_PAGE_SIZE;
const pagePosts = posts.slice(start, start + LIST_PAGE_SIZE);
const latestDateLabel = posts[0] ? posts[0].data.date.toLocaleDateString("en-US", { dateStyle: "medium" }) : "-";

const stripForSearch = (input: string) =>
	input
		.replace(/```[\s\S]*?```/g, " ")
		.replace(/`[^`]*`/g, " ")
		.replace(/[#>*_\-\[\]\(\)!]/g, " ")
		.replace(/\s+/g, " ")
		.toLowerCase();
---

<Layout title={`Blog · Page ${pageNumber}`} description="Posts and notes from SpreadSheets600.">
	<section class="mx-auto max-w-6xl py-10 sm:py-14">
		<header class="card-shell-lg p-6 sm:p-8">
			<p class="text-xs uppercase tracking-[0.2em] text-white/45">Journal</p>
			<div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
				<div>
					<h1 class="text-3xl font-semibold text-white sm:text-4xl">Blog</h1>
					<p class="mt-2 max-w-2xl text-sm text-white/70 sm:text-base">Page {pageNumber} of posts. Search stays available across all entries.</p>
				</div>
				<div class="grid grid-cols-2 gap-2 text-sm lg:w-auto">
					<div class="card-shell px-4 py-3">
						<p class="text-[11px] uppercase tracking-[0.16em] text-white/45">Posts</p>
						<p id="postCount" class="mt-1 text-lg font-semibold text-white">{pagePosts.length}</p>
						<p id="postTotal" class="text-[11px] text-white/45">of {totalCount}</p>
					</div>
					<div class="card-shell px-4 py-3">
						<p class="text-[11px] uppercase tracking-[0.16em] text-white/45">Latest</p>
						<p class="mt-1 text-sm font-medium text-white">{latestDateLabel}</p>
					</div>
				</div>
			</div>

			<div class="mt-6 flex flex-col gap-3 sm:flex-row">
				<label class="relative flex-1">
					<span class="sr-only">Search posts</span>
					<input id="searchInput" type="search" placeholder="Search by keyword or tag..." class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 pr-10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-white/20" />
					<i class="ph ph-magnifying-glass absolute right-3 top-1/2 -translate-y-1/2 text-white/40"></i>
				</label>
				<button id="clearSearch" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-sm text-white/80 transition hover:bg-white/20" type="button">Clear</button>
			</div>
		</header>

		<div id="postGrid" class="mt-7 grid gap-4">
			{
				pagePosts.map((post) => (
					<article class="card-shell-lg group p-5" data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()} data-tags={(post.data.tags || []).join(" ").toLowerCase()} data-body={stripForSearch(post.body ?? "")}>
						<a href={`/blog/${post.slug}/`} class="block">
							<p class="text-xs uppercase tracking-[0.2em] text-white/45">{post.data.date.toLocaleDateString("en-US", { dateStyle: "long" })}</p>
							<h2 class="mt-2 text-xl font-semibold text-white transition group-hover:text-white/90">{post.data.title}</h2>
							<p class="mt-2 text-sm text-white/70">{post.data.description}</p>
						</a>
						{
							post.data.tags?.length ? (
								<ul class="mt-4 flex flex-wrap gap-1.5">
									{post.data.tags.map((tag) => (
										<li>
											<button type="button" class="tag-pill rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] text-white/70 transition hover:border-white/40 hover:text-white" data-tag={tag}>
												{tag}
											</button>
										</li>
									))}
								</ul>
							) : null
						}
					</article>
				))
			}

			{posts.length === 0 && <div class="card-empty">No published posts yet.</div>}
			<div id="noResults" class="card-empty hidden">No posts match your search.</div>
		</div>

		{
			totalPages > 1 && (
				<nav id="paginationNav" class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm text-white/70">
					<a href={pageNumber <= 2 ? "/blog/" : `/blog/page/${pageNumber - 1}/`} class={`rounded-full border border-white/15 px-4 py-2 transition ${pageNumber === 1 ? "pointer-events-none opacity-50" : "hover:border-white/40 hover:text-white"}`}>
						Previous
					</a>
					{Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
						<a href={page === 1 ? "/blog/" : `/blog/page/${page}/`} class={`rounded-full border px-3 py-1.5 transition ${page === pageNumber ? "border-white/50 bg-white/10 text-white" : "border-white/15 hover:border-white/40 hover:text-white"}`}>
							{page}
						</a>
					))}
					<a href={pageNumber >= totalPages ? `/blog/page/${totalPages}/` : `/blog/page/${pageNumber + 1}/`} class={`rounded-full border border-white/15 px-4 py-2 transition ${pageNumber === totalPages ? "pointer-events-none opacity-50" : "hover:border-white/40 hover:text-white"}`}>
						Next
					</a>
				</nav>
			)
		}
	</section>
</Layout>

<script>
	const searchInput = document.getElementById("searchInput");
	const clearSearch = document.getElementById("clearSearch");
	const postCount = document.getElementById("postCount");
	const postTotal = document.getElementById("postTotal");
	const noResults = document.getElementById("noResults");
	const grid = document.getElementById("postGrid");
	const pagination = document.getElementById("paginationNav");
	const initialCards = Array.from(document.querySelectorAll("article[data-title]"));
	let allPostsPromise = null;

	const escapeHtml = (value) => String(value)
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/\"/g, "&quot;")
		.replace(/'/g, "&#39;");

	const formatDate = (value) => new Date(value).toLocaleDateString("en-US", { dateStyle: "long" });

	const loadAllPosts = async () => {
		if (!allPostsPromise) {
			allPostsPromise = fetch("/api/blog-search.json")
				.then((response) => response.json())
				.then((data) => data.posts || []);
		}
		return allPostsPromise;
	};

	const buildCard = (post) => {
		const tags = Array.isArray(post.tags) ? post.tags : [];
		const tagMarkup = tags.length
			? `<ul class="mt-4 flex flex-wrap gap-1.5">${tags.map((tag) => `<li><button type="button" class="tag-pill rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] text-white/70 transition hover:border-white/40 hover:text-white" data-tag="${escapeHtml(tag)}">${escapeHtml(tag)}</button></li>`).join("")}</ul>`
			: "";

		return `<article class="card-shell-lg group p-5" data-title="${escapeHtml(post.title.toLowerCase())}" data-description="${escapeHtml(post.description.toLowerCase())}" data-tags="${escapeHtml(tags.join(" ").toLowerCase())}" data-body="${escapeHtml(post.search || "")}">
			<a href="/blog/${escapeHtml(post.slug)}/" class="block">
				<p class="text-xs uppercase tracking-[0.2em] text-white/45">${formatDate(post.date)}</p>
				<h2 class="mt-2 text-xl font-semibold text-white transition group-hover:text-white/90">${escapeHtml(post.title)}</h2>
				<p class="mt-2 text-sm text-white/70">${escapeHtml(post.description)}</p>
			</a>
			${tagMarkup}
		</article>`;
	};

	const renderPosts = (posts) => {
		if (!grid) return;
		grid.innerHTML = posts.map(buildCard).join("");
	};

	const restoreInitial = () => {
		if (!grid) return;
		grid.innerHTML = "";
		initialCards.forEach((card) => grid.appendChild(card));
	};

	const updateCount = (visible, hasQuery) => {
		if (postCount) postCount.textContent = String(visible);
		if (noResults) noResults.classList.toggle("hidden", !hasQuery || visible !== 0);
	};

	const updateFilter = async () => {
		const query = (searchInput?.value || "").trim().toLowerCase();
		if (!query) {
			restoreInitial();
			pagination?.classList.remove("hidden");
			postTotal?.classList.remove("hidden");
			updateCount(initialCards.length, false);
			if (noResults) noResults.classList.add("hidden");
			return;
		}

		pagination?.classList.add("hidden");
		postTotal?.classList.add("hidden");
		const posts = await loadAllPosts();
		const matches = posts.filter((post) => String(post.search || "").includes(query));
		renderPosts(matches);
		updateCount(matches.length, true);
	};

	const handleTagClick = (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const button = target.closest(".tag-pill");
		if (!button || !searchInput) return;
		searchInput.value = button.getAttribute("data-tag") || "";
		void updateFilter();
	};

	grid?.addEventListener("click", handleTagClick);
	searchInput?.addEventListener("input", () => void updateFilter());
	clearSearch?.addEventListener("click", () => {
		if (!searchInput) return;
		searchInput.value = "";
		void updateFilter();
	});
</script>
