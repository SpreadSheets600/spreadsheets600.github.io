---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const PAGE_SIZE = 10;
const pageNumber = 1;
const totalCount = posts.length;
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

const pagePosts = posts.slice(0, PAGE_SIZE);

const showingCountLabel = pagePosts.length.toLocaleString();
const latestDateLabel = posts[0] ? posts[0].data.date.toLocaleDateString("en-US", { dateStyle: "medium" }) : "—";

const groupedPagePosts = pagePosts.reduce((acc, post) => {
	const year = post.data.date.getFullYear();
	if (!acc.has(year)) acc.set(year, []);

	acc.get(year).push(post);

	return acc;
}, new Map());

const stripForSearch = (input: string) =>
	input
		.replace(/```[\s\S]*?```/g, " ")
		.replace(/`[^`]*`/g, " ")
		.replace(/[#>*_\-\[\]\(\)!]/g, " ")
		.replace(/\s+/g, " ")
		.toLowerCase();
---

<Layout title="Blog" description="Posts and notes from SpreadSheets600.">
	<section class="mx-auto max-w-7xl py-10 sm:py-14">
		<header class="mb-8 sm:mb-12">
			<div class="card-shell-lg p-6 sm:p-8">
				<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
					<div class="max-w-2xl">
						<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
							<span class="bg-gradient-to-b from-white to-white/70 bg-clip-text">The Blog</span>
						</h1>
					</div>

					<div class="grid grid-cols-2 gap-2 w-full lg:w-auto">
						<div class="card-shell group relative overflow-hidden px-3 py-2.5">
							<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-sky-400/10 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
							<div class="relative flex items-center gap-2.5">
								<div class="flex h-9 w-9 items-center justify-center rounded-lg border border-sky-300/30 bg-sky-400/10 text-sky-200 shadow-[0_0_16px_rgba(56,189,248,0.2)]">
									<i class="ph ph-newspaper-clipping text-lg"></i>
								</div>
								<div class="leading-tight">
									<p class="text-[11px] uppercase tracking-[0.14em] text-white/50">Showing</p>
									<p id="postCount" class="mt-0.5 text-xl font-bold text-white">{showingCountLabel}</p>
								</div>
							</div>
						</div>
						<div class="card-shell group relative overflow-hidden px-3 py-2.5">
							<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-amber-300/10 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
							<div class="relative flex items-center gap-2.5">
								<div class="flex h-9 w-9 items-center justify-center rounded-lg border border-amber-300/30 bg-amber-300/10 text-amber-200 shadow-[0_0_16px_rgba(252,211,77,0.2)]">
									<i class="ph ph-calendar-blank text-lg"></i>
								</div>
								<div class="leading-tight">
									<p class="text-[11px] uppercase tracking-[0.14em] text-white/50">Latest</p>
									<p class="mt-0.5 text-xl font-bold text-white">{latestDateLabel}</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
				<label class="relative flex-1">
					<span class="sr-only">Search posts</span>
					<input id="searchInput" type="search" placeholder="Search posts, tags, and topics..." class="w-full rounded-2xl border border-white/10 bg-black/30 px-4 py-3 pr-10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-white/30" />
					<i class="ph ph-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-white/40"></i>
				</label>

				<button id="clearSearch" class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 text-sm text-white/80 hover:bg-white/20 transition" type="button"> Clear </button>
			</div>

			<div id="postGrid" class="mt-8 grid gap-8 sm:gap-10">
				{
					Array.from(groupedPagePosts.entries()).map(([year, yearPosts]) => (
						<div class="grid gap-5 sm:gap-6">
							<h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-white/40">{year}</h3>
							{yearPosts.map((post) => (
								<article class="card-shell-lg group p-5 sm:p-7 hover:border-white/30 hover:bg-black/45" data-title={post.data.title.toLowerCase()} data-tags={(post.data.tags || []).join(" ").toLowerCase()} data-body={stripForSearch(post.body ?? "")}>
									<a href={`/blog/${post.slug}/`} class="block">
										<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
											<div>
												<h2 class="text-xl sm:text-2xl font-semibold text-white group-hover:text-white/90">{post.data.title}</h2>
											</div>
											<div class="inline-flex items-center text-sm text-white/60 transition group-hover:text-white/80 sm:mt-1">
												<i class="ph ph-arrow-up-right" />
											</div>
										</div>
									</a>
								</article>
							))}
						</div>
					))
				}

				{posts.length === 0 && <div class="card-empty">No published posts yet.</div>}

				<div id="noResults" class="hidden card-empty">No posts match your search.</div>
			</div>

			{
				totalPages > 1 && (
					<nav id="paginationNav" class="mt-10 flex flex-wrap items-center justify-center gap-2 text-sm text-white/70">
						<a href={`/blog/`} class={`rounded-full border border-white/15 px-4 py-2 transition ${pageNumber === 1 ? "pointer-events-none opacity-50" : "hover:border-white/40 hover:text-white"}`}>
							Previous
						</a>
						{Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
							<a href={page === 1 ? `/blog/` : `/blog/page/${page}/`} class={`rounded-full border px-3 py-1.5 transition ${page === pageNumber ? "border-white/60 bg-white/15 text-white" : "border-white/15 hover:border-white/40 hover:text-white"}`}>
								{page}
							</a>
						))}
						<a href={pageNumber === totalPages ? `/blog/page/${totalPages}/` : `/blog/page/${pageNumber + 1}/`} class={`rounded-full border border-white/15 px-4 py-2 transition ${pageNumber === totalPages ? "pointer-events-none opacity-50" : "hover:border-white/40 hover:text-white"}`}>
							Next
						</a>
					</nav>
				)
			}
		</header>
	</section>

	<script>
		const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
		const clearSearch = document.getElementById("clearSearch");
		const postCount = document.getElementById("postCount");

		const grid = document.getElementById("postGrid");
		const pagination = document.getElementById("paginationNav");
		const initialCards = Array.from(document.querySelectorAll("article[data-title]"));
		const initialGridHtml = grid?.innerHTML ?? "";

		let allPostsPromise = null;

		const escapeHtml = (value) => String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\"/g, "&quot;").replace(/'/g, "&#39;");

		const loadAllPosts = async () => {
			if (!allPostsPromise) {
				allPostsPromise = fetch("/api/blog-search.json")
					.then((response) => response.json())
					.then((data) => data.posts || []);
			}
			return allPostsPromise;
		};

		const buildCard = (post) => {
			const tags = Array.isArray(post.tags) ? post.tags : [];
			return `
				<article class="card-shell-lg group p-5 sm:p-7 hover:border-white/30 hover:bg-black/45" data-title="${escapeHtml(post.title.toLowerCase())}" data-tags="${escapeHtml(tags.join(" ").toLowerCase())}" data-body="${escapeHtml(post.search || "")}">
					<a href="/blog/${escapeHtml(post.slug)}/" class="block">
						<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
							<div>
								<h2 class="text-xl sm:text-2xl font-semibold text-white group-hover:text-white/90">${escapeHtml(post.title)}</h2>
							</div>
							<div class="inline-flex items-center text-sm text-white/60 transition group-hover:text-white/80 sm:mt-1">
								<i class="ph ph-arrow-up-right"></i>
							</div>
						</div>
					</a>
				</article>
			`;
		};

		const renderPosts = (posts) => {
			if (!grid) return;
			const grouped = posts.reduce((acc, post) => {
				const year = new Date(post.date).getFullYear();
				if (!acc.has(year)) acc.set(year, []);
				acc.get(year).push(post);
				return acc;
			}, new Map());

			const groupsMarkup = Array.from(grouped.entries())
				.map(([year, yearPosts]) => `
					<div class="grid gap-5 sm:gap-6">
						<h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-white/40">${year}</h3>
						${yearPosts.map((post) => buildCard(post)).join("")}
					</div>
				`)
				.join("");

			grid.innerHTML = `${groupsMarkup}<div id="noResults" class="hidden card-empty">No posts match your search.</div>`;
		};

		const restoreInitial = () => {
			if (!grid) return;
			grid.innerHTML = initialGridHtml;
		};

		const updateCount = (visible, hasQuery) => {
			const noResults = document.getElementById("noResults");
			if (postCount) postCount.textContent = String(visible);
			if (noResults) noResults.classList.toggle("hidden", !hasQuery || visible !== 0);
		};

		const updateFilter = async () => {
			const query = (searchInput?.value || "").trim().toLowerCase();
			if (!query) {
				restoreInitial();
				pagination?.classList.remove("hidden");
				updateCount(initialCards.length, false);
				return;
			}

			pagination?.classList.add("hidden");
			const posts = await loadAllPosts();
			const matches = posts.filter((post) => String(post.search || "").includes(query));
			renderPosts(matches);
			updateCount(matches.length, true);
		};

		const params = new URLSearchParams(window.location.search);
		const initialQuery = params.get("q") || params.get("tag");
		if (initialQuery && searchInput) {
			searchInput.value = initialQuery;
			void updateFilter();
		}

		searchInput?.addEventListener("input", updateFilter);
		clearSearch?.addEventListener("click", () => {
			if (!searchInput) return;
			searchInput.value = "";
			updateFilter();
		});
	</script>
</Layout>
