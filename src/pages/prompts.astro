---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const prompts = await getCollection('prompts');
const sortedPrompts = prompts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group by category
const categories = [...new Set(prompts.map((p) => p.data.category))];
---

<Layout title="Prompts - Soham Maity">
  <section class="max-w-7xl mx-auto px-4 py-20">
    <h1 class="text-5xl font-bold mb-4 text-center gradient-text">Prompts</h1>
    <p class="text-center text-muted-foreground mb-16">Useful AI prompts I've created</p>

    {categories.map((category) => {
      const categoryPrompts = sortedPrompts.filter((p) => p.data.category === category);
      return (
        <div class="mb-12">
          <h2 class="text-3xl font-bold mb-6">{category}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {categoryPrompts.map((prompt) => (
              <a href={`/prompts/${prompt.slug}`} class="prompt-card group">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-xl font-semibold group-hover:text-primary transition-colors flex-1">
                    {prompt.data.title}
                  </h3>
                  <svg
                    class="w-5 h-5 text-muted-foreground group-hover:text-primary transition-colors flex-shrink-0 ml-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </div>
                <p class="text-sm text-muted-foreground mb-3">{prompt.data.description}</p>
                {prompt.data.tags && (
                  <div class="flex flex-wrap gap-2">
                    {prompt.data.tags.map((tag) => (
                      <span class="text-xs bg-secondary text-secondary-foreground px-2 py-1 rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </div>
      );
    })}

    {sortedPrompts.length === 0 && (
      <div class="text-center text-muted-foreground py-20">
        <p>No prompts yet. Check back soon!</p>
      </div>
    )}
  </section>
</Layout>

<style>
  .prompt-card {
    @apply bg-card border border-border rounded-lg p-6 hover:border-primary/50 transition-all duration-300 hover:shadow-lg hover:shadow-primary/10 block;
  }
</style>
