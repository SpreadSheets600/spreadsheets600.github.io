---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getLanguageColor, DEFAULT_LANGUAGE_COLOR } from "../lib/languageColors.js";

interface GitHubRepo {
	name: string;
	description: string | null;

	html_url: string;
	homepage: string | null;
	language: string | null;

	topics: string[];

	stargazers_count: number;
	forks_count: number;
	updated_at: string;
}

const GITHUB_USERNAME = "SpreadSheets600";

let allProjects: GitHubRepo[] = [];
let error = false;

try {
	const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100&type=owner`, {
		headers: {
			Accept: "application/vnd.github+json",
			"User-Agent": "Astro-Portfolio",
		},
	});

	if (response.ok) {
		const data = await response.json();
		allProjects = data
			.filter((repo: any) => !repo.fork && !repo.archived)
			.map((repo: any) => ({
				name: repo.name,
				description: repo.description,
				html_url: repo.html_url,
				homepage: repo.homepage,
				language: repo.language,
				topics: repo.topics || [],
				stargazers_count: repo.stargazers_count,
				forks_count: repo.forks_count,
				updated_at: repo.updated_at,
			}));
	} else {
		error = true;
	}
} catch (e) {
	error = true;
}

const totalStars = allProjects.reduce((sum, project) => sum + (project.stargazers_count || 0), 0);

const languageCounts = allProjects.reduce(
	(acc, project) => {
		if (!project.language) return acc;
		acc[project.language] = (acc[project.language] || 0) + 1;
		return acc;
	},
	{} as Record<string, number>,
);

const totalLangCount = Object.values(languageCounts).reduce((sum, count) => sum + count, 0);
const sortedLanguageStats = Object.entries(languageCounts)
	.map(([language, count]) => ({
		language,
		count,
		percent: totalLangCount ? (count / totalLangCount) * 100 : 0,
	}))
	.sort((a, b) => b.count - a.count);

const topLanguageStats = sortedLanguageStats.slice(0, 5).map((stat) => ({
	...stat,
	color: getLanguageColor(stat.language),
}));

const topLanguageTotal = topLanguageStats.reduce((sum, stat) => sum + stat.count, 0);
const otherCount = totalLangCount - topLanguageTotal;

const languageSegments =
	otherCount > 0 ?
		[
			...topLanguageStats,
			{
				language: "Other",
				count: otherCount,
				percent: totalLangCount ? (otherCount / totalLangCount) * 100 : 0,
				color: DEFAULT_LANGUAGE_COLOR,
			},
		]
	:	topLanguageStats;
---

<Layout title="Projects | SpreadSheets600">
	<main class="py-8 sm:py-16 flex-1">
		<header class="mb-8 sm:mb-12">
			<div class="rounded-3xl border border-white/10 bg-black/40 p-6 sm:p-8 backdrop-blur-xl">
				<div class="flex flex-col gap-6">
					<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
						<div class="max-w-2xl">
							<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
								<span class="bg-linear-to-b from-white to-white/70 bg-clip-text "> My Projects </span>
							</h1>
						</div>

						<div class="grid grid-cols-2 gap-3 w-full lg:w-auto">
							<div class="rounded-2xl border border-white/10 bg-black/40 px-4 py-3 backdrop-blur-md">
								<p class="text-xs uppercase tracking-wide text-white/50">Repositories</p>
								<p class="text-lg font-semibold text-white">
									{allProjects.length}
								</p>
							</div>
							<div class="rounded-2xl border border-white/10 bg-black/40 px-4 py-3 backdrop-blur-md">
								<p class="text-xs uppercase tracking-wide text-white/50">Total Stars</p>
								<p class="text-lg font-semibold text-white">
									{totalStars}
								</p>
							</div>
						</div>
					</div>

					{
						totalLangCount === 0 ?
							<p class="text-sm text-white/50">No language data yet.</p>
						:	<div class="rounded-2xl">
								<div class="relative flex h-4 overflow-hidden rounded-full border border-white/10 bg-white/5">
									{languageSegments.map((segment) => (
										<div class="h-full" style={`flex: 0 0 ${segment.percent.toFixed(2)}%; background: ${segment.color}; min-width: 2px;`} title={`${segment.language} · ${Math.round(segment.percent)}%`} />
									))}
									<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-white/10 via-transparent to-white/10" />
								</div>

								<div class="mt-4 flex flex-wrap gap-2">
									{languageSegments.map((segment) => (
										<div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-1 text-xs text-white/70">
											<span class="h-2 w-2 rounded-full" style={`background: ${segment.color};`} />
											<span class="font-semibold text-white">{segment.language}</span>
											<span>{Math.round(segment.percent)}%</span>
										</div>
									))}
								</div>
							</div>
					}
				</div>
			</div>
		</header>

		{
			error ?
				<div class="rounded-2xl border border-white/10 bg-black/40 p-8 text-center backdrop-blur-xl">
					<i class="ph ph-warning text-4xl text-white/40 mb-4" />
					<p class="text-white/60">Unable to load projects from GitHub. Please try again later.</p>
				</div>
			: allProjects.length === 0 ?
				<div class="rounded-2xl border border-white/10 bg-black/40 p-8 text-center backdrop-blur-xl">
					<i class="ph ph-folder-open text-4xl text-white/40 mb-4" />
					<p class="text-white/60">No projects found.</p>
				</div>
			:	<div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{allProjects.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
		}
	</main>
</Layout>
