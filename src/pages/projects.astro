---
import Layout from "../layouts/Layout.astro";

// Static at build time: data is read during the build, not on every request.
export const prerender = true;

import ProjectCard from "../components/ProjectCard.astro";
import { fetchPublicRepos, type GitHubRepo } from "../lib/repositories.ts";
import { API_BASE } from "../lib/api";
import { getLanguageColorMap, getLanguageColorSync, DEFAULT_LANGUAGE_COLOR } from "../lib/languageColors.js";

const GITHUB_USERNAME = "SpreadSheets600";

let allProjects: GitHubRepo[] = [];
let error = false;

try {
	const githubToken = Astro.locals.runtime?.env?.GITHUB_PAT || Astro.locals.runtime?.env?.GITHUB_TOKEN || import.meta.env.GITHUB_PAT || import.meta.env.GITHUB_TOKEN;
	const { repos } = await fetchPublicRepos(GITHUB_USERNAME, githubToken);
	allProjects = repos;
	error = repos.length === 0;
} catch (e) {
	error = true;
}

// Same profile API snapshot the home page uses: totals and the language mix come from it.
interface ApiGithub {
	repos?: number;
	stars?: number;
	languages?: { name: string; color: string | null; repos: number }[];
}

const fetchApiGithub = async (): Promise<ApiGithub | null> => {
	try {
		const response = await fetch(`${API_BASE}/snapshot`, { signal: AbortSignal.timeout(15000) });
		if (!response.ok) return null;
		const snapshot = await response.json();
		return snapshot?.github?.ok ? (snapshot.github.data as ApiGithub) : null;
	} catch {
		return null;
	}
};

const api = await fetchApiGithub();

const localStars = allProjects.reduce((sum, project) => sum + (project.stargazers_count || 0), 0);
const repoCountLabel = (api?.repos ?? allProjects.length).toLocaleString();
const starCountLabel = (api?.stars ?? localStars).toLocaleString();

const languageRows: { language: string; count: number; color: string | null }[] = api?.languages?.length
	? api.languages.map((item) => ({ language: item.name, count: item.repos, color: item.color }))
	: Object.entries(
			allProjects.reduce(
				(acc, project) => {
					if (project.language) acc[project.language] = (acc[project.language] || 0) + 1;
					return acc;
				},
				{} as Record<string, number>,
			),
		).map(([language, count]) => ({ language, count, color: null }));

const sortedLanguages = languageRows.filter((row) => row.count > 0).sort((a, b) => b.count - a.count);
const totalLangCount = sortedLanguages.reduce((sum, row) => sum + row.count, 0);
const languageColorMap = await getLanguageColorMap();

const topLanguageStats = sortedLanguages.slice(0, 5).map((row) => ({
	language: row.language,
	count: row.count,
	percent: totalLangCount ? (row.count / totalLangCount) * 100 : 0,
	color: row.color ?? getLanguageColorSync(row.language, languageColorMap),
}));

const topLanguageTotal = topLanguageStats.reduce((sum, stat) => sum + stat.count, 0);
const otherCount = totalLangCount - topLanguageTotal;

const languageSegments =
	otherCount > 0 ?
		[
			...topLanguageStats,
			{
				language: "Other",
				count: otherCount,
				percent: totalLangCount ? (otherCount / totalLangCount) * 100 : 0,
				color: DEFAULT_LANGUAGE_COLOR,
			},
		]
	:	topLanguageStats;

---

<Layout title="Projects | SpreadSheets600">
	<main class="py-8 sm:py-16 flex-1">
		<header class="mb-8 sm:mb-12">
			<div class="card-shell-lg p-6 sm:p-8">
				<div class="flex flex-col gap-6">
					<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
						<div class="max-w-2xl">
							<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
								<span class="bg-gradient-to-b from-white to-white/70 bg-clip-text text-transparent">My Projects</span>
							</h1>
						</div>

						<div class="grid grid-cols-2 gap-2 w-full lg:w-auto">
							<div class="card-shell group relative overflow-hidden px-3 py-2.5">
								<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-cyan-400/10 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
								<div class="relative flex items-center gap-2.5">
									<div class="flex h-9 w-9 items-center justify-center rounded-lg border border-cyan-300/30 bg-cyan-400/10 text-cyan-200 shadow-[0_0_16px_rgba(34,211,238,0.2)]">
										<i class="ph ph-git-branch text-lg"></i>
									</div>
									<div class="leading-tight">
										<p class="text-[11px] uppercase tracking-[0.14em] text-white/50">Repositories</p>
										<p class="mt-0.5 text-xl font-bold text-white">{repoCountLabel}</p>
									</div>
								</div>
							</div>
							<div class="card-shell group relative overflow-hidden px-3 py-2.5">
								<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-amber-300/10 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-100"></div>
								<div class="relative flex items-center gap-2.5">
									<div class="flex h-9 w-9 items-center justify-center rounded-lg border border-amber-200/30 bg-amber-200/10 text-amber-200 shadow-[0_0_16px_rgba(251,191,36,0.16)]">
										<i class="ph ph-star text-lg"></i>
									</div>
									<div class="leading-tight">
										<p class="text-[11px] uppercase tracking-[0.14em] text-white/50">Total Stars</p>
										<p class="mt-0.5 text-xl font-bold text-white">{starCountLabel}</p>
									</div>
								</div>
							</div>
						</div>
					</div>

					{
						totalLangCount === 0 ?
							<p class="text-sm text-white/50">No language data yet.</p>
						:	<div class="rounded-2xl">
								<div class="relative flex h-4 overflow-hidden rounded-full border border-white/10 bg-white/5">
									{languageSegments.map((segment) => (
										<div class="h-full" style={`flex: 0 0 ${segment.percent.toFixed(2)}%; background: ${segment.color}; min-width: 2px;`} title={`${segment.language} · ${Math.round(segment.percent)}%`} />
									))}
									<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-white/10 via-transparent to-white/10" />
								</div>

								<div class="mt-4 flex flex-wrap gap-2">
									{languageSegments.map((segment) => (
										<div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-1 text-xs text-white/70">
											<span class="h-2 w-2 rounded-full" style={`background: ${segment.color};`} />
											<span class="font-semibold text-white">{segment.language}</span>
											<span>{Math.round(segment.percent)}%</span>
										</div>
									))}
								</div>
							</div>
					}
				</div>
			</div>
		</header>

		{
			error ?
				<div class="card-empty">
					<i class="ph ph-warning text-4xl text-white/40 mb-4" />
					<p class="text-white/60">Unable to load projects from GitHub. Please try again later.</p>
				</div>
			: allProjects.length === 0 ?
				<div class="card-empty">
					<i class="ph ph-folder-open text-4xl text-white/40 mb-4" />
					<p class="text-white/60">No projects found.</p>
				</div>
			:	<>
					<div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{allProjects.map((project) => (
							<ProjectCard project={project} />
						))}
					</div>
				</>
		}
	</main>
</Layout>
