---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import Footer from '../components/Footer.astro';

const webApps = [
  {
    title: "PoraHobeBot",
    description: "Academic notes sharing platform with modern UI.",
    icon: "ph-notebook",
    iconColor: "text-green-400",
    bgColor: "bg-green-500/20 border-green-500/30",
    links: [
      { label: "GitHub", url: "#", primary: true },
      { label: "Visit Site", url: "http://dono-03.danbot.host:2521/", primary: false },
    ],
  },
  {
    title: "Frontpage Generator",
    description: "Generate academic frontpage covers automatically.",
    icon: "ph-file-text",
    iconColor: "text-purple-400",
    bgColor: "bg-purple-500/20 border-purple-500/30",
    links: [
      { label: "GitHub", url: "#", primary: true },
      { label: "Visit Site", url: "http://dono-01.danbot.host:7850/frontpages", primary: false },
    ],
  },
];

const bots = [
  {
    title: "Dependency Tracker",
    description: "Automatically tracks dependencies from GitHub and puts their releases with links in a repo.",
    icon: "ph-git-branch",
    iconColor: "text-green-400",
    bgColor: "bg-green-500/20 border-green-500/30",
    links: [{ label: "GitHub", url: "https://github.com/NovatraX/dependency-tracker", primary: true }],
  },
  {
    title: "Astrum V2",
    description: "Multipurpose Discord bot made using py-cord.",
    icon: "ph-discord-logo",
    iconColor: "text-indigo-400",
    bgColor: "bg-indigo-500/20 border-indigo-500/30",
    links: [{ label: "GitHub", url: "https://github.com/Sheets-Astrum-BOT/Astrum-V2", primary: true }],
  },
  {
    title: "FreeGames Bot",
    description: "Discord bot for GamerPower giveaways with slash commands.",
    icon: "ph-game-controller",
    iconColor: "text-purple-400",
    bgColor: "bg-purple-500/20 border-purple-500/30",
    links: [{ label: "GitHub", url: "#", primary: true }],
  },
];

const academicResources = [
  {
    title: "IITM Java",
    description: "Lecture notes, assignment solutions, and resources for IITM Java course.",
    icon: "ph-coffee",
    iconColor: "text-orange-500",
    bgColor: "bg-orange-500/20 border-orange-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-JAVA", primary: true }],
  },
  {
    title: "IITM MLT",
    description: "Course materials and assignments for IITM Machine Learning Techniques course.",
    icon: "ph-brain",
    iconColor: "text-purple-400",
    bgColor: "bg-purple-500/20 border-purple-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-MLT", primary: true }],
  },
  {
    title: "IITM SC",
    description: "System Commands course materials and practical exercises.",
    icon: "ph-terminal-window",
    iconColor: "text-gray-400",
    bgColor: "bg-gray-500/20 border-gray-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-SC", primary: true }],
  },
  {
    title: "IITM MAD 1",
    description: "Modern Application Development 1 course notes and assignments.",
    icon: "ph-code-simple",
    iconColor: "text-indigo-400",
    bgColor: "bg-indigo-500/20 border-indigo-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-MAD1", primary: true }],
  },
  {
    title: "IITM MAD 2",
    description: "Modern Application Development 2 course resources and projects.",
    icon: "ph-devices",
    iconColor: "text-blue-400",
    bgColor: "bg-blue-500/20 border-blue-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-MAD2", primary: true }],
  },
  {
    title: "IITM PDSA",
    description: "Programming, Data Structures and Algorithms course materials.",
    icon: "ph-tree-structure",
    iconColor: "text-green-400",
    bgColor: "bg-green-500/20 border-green-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-PDSA", primary: true }],
  },
  {
    title: "IITM Python",
    description: "Python programming course materials and practice problems.",
    icon: "ph-file-py",
    iconColor: "text-yellow-400",
    bgColor: "bg-yellow-500/20 border-yellow-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/IITM-Python", primary: true }],
  },
];

const resources = [
  {
    title: "Pterodactyl Multiprocess Template",
    description: "Drop-in template that turns a single Pterodactyl server into a tiny process host using Supervisor.",
    icon: "ph-cpu",
    iconColor: "text-red-400",
    bgColor: "bg-red-500/20 border-red-500/30",
    links: [{ label: "GitHub", url: "https://github.com/SpreadSheets600/Pterodactyl-Multiprocess-Template", primary: true }],
  },
  {
    title: "Python Programs",
    description: "Python practical program list for learning.",
    icon: "ph-file-py",
    iconColor: "text-orange-400",
    bgColor: "bg-orange-500/20 border-orange-500/30",
    links: [
      { label: "GitHub", url: "https://github.com/SpreadSheets600/Python-Programs", primary: true },
      { label: "Visit Site", url: "https://spreadsheets600.is-a.dev/Python-Programs/", primary: false },
    ],
  },
  {
    title: "C DSA Programs",
    description: "C DSA program list for data structures and algorithms.",
    icon: "ph-file-c",
    iconColor: "text-cyan-400",
    bgColor: "bg-cyan-500/20 border-cyan-500/30",
    links: [
      { label: "GitHub", url: "https://github.com/SpreadSheets600/C-DSA-Programs", primary: true },
      { label: "Visit Site", url: "https://spreadsheets600.is-a.dev/C-DSA-Programs", primary: false },
    ],
  },
];
---

<Layout title="Tools | Soham's Portfolio">
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-16 flex-1">
    <header class="text-center mb-8 sm:mb-12">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
        <span class="bg-gradient-to-b from-white to-white/70 bg-clip-text text-transparent">Tools & Projects</span>
      </h1>
      <p class="mt-4 max-w-2xl text-white/80 mx-auto text-sm sm:text-base">Collection of tools, projects, and resources I've created</p>
    </header>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-semibold mb-4 sm:mb-6 flex items-center gap-3">
        <i class="ph ph-globe text-blue-400 text-2xl"></i>
        Web Applications
      </h2>
      <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {webApps.map((app) => <ToolCard tool={app} />)}
      </div>
    </section>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-semibold mb-4 sm:mb-6 flex items-center gap-3">
        <i class="ph ph-robot text-indigo-400 text-2xl"></i>
        Bots & Automation
      </h2>
      <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {bots.map((bot) => <ToolCard tool={bot} />)}
      </div>
    </section>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-semibold mb-4 sm:mb-6 flex items-center gap-3">
        <i class="ph ph-graduation-cap text-green-400 text-2xl"></i>
        Academic Resources
      </h2>
      <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {academicResources.map((course) => <ToolCard tool={course} />)}
      </div>
    </section>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-semibold mb-4 sm:mb-6 flex items-center gap-3">
        <i class="ph ph-code text-orange-400 text-2xl"></i>
        Programming Resources
      </h2>
      <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {resources.map((resource) => <ToolCard tool={resource} />)}
      </div>
    </section>

    <Footer />
  </main>
</Layout>
