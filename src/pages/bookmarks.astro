---
import Layout from "../layouts/Layout.astro";
import ToolCard from "../components/ToolCard.astro";
import { getCollection } from "astro:content";

const sections = (await getCollection("bookmarks"))
	.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
	.map((entry) => ({
		id: entry.id,
		...entry.data,
	}));

const totalItems = sections.reduce((sum, section) => sum + section.items.length, 0);
const totalCategories = sections.length;

const openSourceCount = sections.reduce((sum, section) => sum + section.items.filter((item) => (item.links ?? []).some((link) => link.label.toLowerCase().includes("github"))).length, 0);

const liveSitesCount = sections.reduce((sum, section) => sum + section.items.filter((item) => (item.links ?? []).some((link) => link.label.toLowerCase().includes("visit"))).length, 0);
---

<Layout title="Bookmarks | SpreadSheets600">
	<main class="py-8 sm:py-16 flex-1">
		<header class="mb-8 sm:mb-12">
			<div class="card-shell-lg p-6 sm:p-8">
				<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
					<div class="max-w-2xl">
						<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
							<span class="bg-gradient-to-b from-white to-white/70 bg-clip-text">Bookmarks</span>
						</h1>
					</div>

					<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full lg:w-auto">
						<div class="card-shell px-4 py-3">
							<p class="text-xs uppercase tracking-wide text-white/50">Items</p>
							<p class="text-lg font-semibold text-white">{totalItems}</p>
						</div>
						<div class="card-shell px-4 py-3">
							<p class="text-xs uppercase tracking-wide text-white/50">Categories</p>
							<p class="text-lg font-semibold text-white">{totalCategories}</p>
						</div>
						<div class="card-shell px-4 py-3">
							<p class="text-xs uppercase tracking-wide text-white/50">Open Source</p>
							<p class="text-lg font-semibold text-white">{openSourceCount}</p>
						</div>
						<div class="card-shell px-4 py-3">
							<p class="text-xs uppercase tracking-wide text-white/50">Live Demos</p>
							<p class="text-lg font-semibold text-white">{liveSitesCount}</p>
						</div>
					</div>
				</div>
			</div>
		</header>

		{
			sections.map((section) => (
				<section id={section.id} class="scroll-mt-24 mb-12 sm:mb-16">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6">
						<div class="flex items-start gap-4">
							<div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5" style={`background: linear-gradient(140deg, ${section.accentFaint}, rgba(255, 255, 255, 0.02)); border-color: ${section.accentSoft}; color: ${section.accent};`}>
								<i class={`ph ${section.icon} text-2xl`} />
							</div>
							<div>
								<h2 class="text-2xl font-bold text-white">{section.title}</h2>
								<p class="text-sm text-white/60">{section.description}</p>
							</div>
						</div>
						<span class="rounded-full border border-white/15 bg-black/30 px-3 py-1.5 text-xs font-semibold text-white" style={`border-color: ${section.accentSoft}; background: linear-gradient(135deg, ${section.accentFaint}, rgba(255, 255, 255, 0.04));`}>
							{section.items.length} items
						</span>
					</div>

					<div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{section.items.map((item) => (
							<ToolCard tool={item} accent={section.accent} accentSoft={section.accentSoft} accentFaint={section.accentFaint} />
						))}
					</div>
				</section>
			))
		}
	</main>
</Layout>

<script>
	const copyButtons = Array.from(document.querySelectorAll("[data-copy-prompt]"));

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const prompt = button.getAttribute("data-copy-prompt") || "";
			if (!prompt) return;
			try {
				await navigator.clipboard.writeText(prompt);
				button.textContent = "Copied";
				setTimeout(() => (button.textContent = "Copy Prompt"), 1400);
			} catch (error) {
				button.textContent = "Copy failed";
				setTimeout(() => (button.textContent = "Copy Prompt"), 1400);
			}
		});
	});
</script>
